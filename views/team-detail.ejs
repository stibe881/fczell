<% const pageTitle = team.name; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Junioren</p>
    <h1><%= team.name %></h1>
    <% if (team.league) { %><p><%= team.league %></p><% } %>
  </div>
</section>

<section class="band band-light">
  <div class="team-detail-card" style="max-width: var(--max-w); margin: 0 auto; background: #fff; border-radius: var(--radius); border: 1px solid rgba(0,0,0,0.06); overflow: hidden;">
    
    <% if (team.photo) { %>
      <div class="team-photo" style="width: 100%; background: #f4f4f4;">
        <a href="<%= team.photo %>" class="lightbox-trigger" style="display: block;">
          <img src="<%= team.photo %>" alt="<%= team.name %>" style="width: 100%; height: auto; display: block;" />
        </a>
      </div>
    <% } %>

    <div style="padding: 2rem;">
      <dl class="team-info">
        <% if (team.staff && team.staff.length > 0) { %>
          <% team.staff.forEach(s => { %>
            <div>
              <dt><%= s.role %></dt>
              <dd>
                <%= s.name %>
                <% if (s.phone) { %> <br><a href="tel:<%= s.phone.replace(/\s/g,'') %>" style="color:var(--fcz-gray-600); text-decoration:none; font-size:0.9em;"><%= s.phone %></a><% } %>
                <% if (s.email) { %> <br><a href="mailto:<%= s.email %>" style="color:var(--fcz-gray-600); text-decoration:none; font-size:0.9em;"><%= s.email %></a><% } %>
              </dd>
            </div>
          <% }) %>
        <% } %>
        <% if (team.times) { %><div><dt>Trainingszeiten</dt><dd><%= team.times %></dd></div><% } %>
        <% if (team.location) { %><div><dt>Trainingsort</dt><dd><%= team.location %></dd></div><% } %>
        <% if (team.extra) { %><div><dt>Info</dt><dd><%- team.extra %></dd></div><% } %>
        <% if (team.contact_phone || team.contact_email) { %>
          <div>
            <dt>Kontakt</dt>
            <dd>
              <% if (team.contact_phone) { %><a href="tel:<%= team.contact_phone.replace(/\s/g, '') %>" style="color:var(--fcz-gray-600); text-decoration:none;"><%= team.contact_phone %></a><br><% } %>
              <% if (team.contact_email) { %><a href="mailto:<%= team.contact_email %>" style="color:var(--fcz-gray-600); text-decoration:none;"><%= team.contact_email %></a><% } %>
            </dd>
          </div>
        <% } %>
      </dl>

      <% if (team.sponsor_logo) { %>
        <div class="team-sponsor-premium" style="margin-top: 4rem; padding: 3rem 2rem; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 16px; text-align: center; position: relative; overflow: hidden; box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);">
          <!-- Decorative element -->
          <div style="position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: var(--fcz-red); opacity: 0.04; border-radius: 50%;"></div>
          <div style="position: absolute; bottom: -20px; left: -20px; width: 80px; height: 80px; background: var(--fcz-red); opacity: 0.04; border-radius: 50%;"></div>
          
          <p style="font-size: 0.75rem; font-weight: 800; color: var(--fcz-red); text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 2rem; position: relative; z-index: 2;">
            Offizieller Dresssponsor
          </p>
          
          <div style="background: #fff; display: inline-flex; align-items: center; justify-content: center; padding: 2rem 3rem; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); position: relative; z-index: 2;" onmouseover="this.style.transform='translateY(-6px)'" onmouseout="this.style.transform='translateY(0)'">
            <img src="<%= team.sponsor_logo %>" alt="Dresssponsor <%= team.name %>" style="max-height: 90px; max-width: 250px; object-fit: contain;" />
          </div>
        </div>
      <% } %>

      <% if (team.sfv_team_id) { %>
        <div class="team-widget" style="margin-top: 4rem;">
          <h3 style="margin-bottom: 1.5rem; color: var(--fcz-gray-800);">Resultate &amp; Rangliste</h3>
          <div style="overflow: hidden; width: 100%;">
            <iframe name="sfvWidget_<%= team.sfv_team_id %>" id="sfvWidget_<%= team.sfv_team_id %>"  class="sfvFullHeight" src="https://widget.football.ch/Widgets.aspx/v-384/t-<%= team.sfv_team_id %>/a-trr/" width="100%" frameborder="0" scrolling="auto" style="border: none; background: transparent; min-height: 950px; width: 100%; margin-top: -130px;"></iframe>
          </div>
          <script src="https://widget.football.ch/portaldata/30/scripts/sfvVereinWidget.js"></script>
        </div>
      <% } %>

      <div style="margin-top: 3rem; text-align: center;">
        <a href="/mannschaften#junioren" class="btn btn-outline">&larr; Zurück zur Übersicht</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
