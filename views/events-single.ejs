<% const pageTitle = event.title; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">
      <% const d = new Date(event.event_date); %>
      <%= d.toLocaleDateString('de-CH', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' }) %>
    </p>
    <h1><%= event.title %></h1>
    <% if (event.location) { %>
      <p style="display:flex; align-items:center; justify-content:center; gap:0.5rem; margin-top:1rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-map-pin"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> 
        <%= event.location %>
      </p>
    <% } %>
  </div>
</section>

<section class="band band-light">
  <div class="prose">
    <% if (event.description) { %>
      <p style="white-space: pre-line; font-size: 1.1rem; color: var(--fcz-gray-700);"><%= event.description %></p>
    <% } else { %>
      <p>Keine weiteren Details zu diesem Event verfügbar.</p>
    <% } %>

    <% if (event.is_match) { %>
      <div class="live-ticker" style="margin-top: 3rem; background: #fff; border: 2px solid var(--fcz-red); border-radius: var(--radius); padding: 2rem;">
        <h3 style="color: var(--fcz-red-dark); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
          <span style="display: inline-block; width: 12px; height: 12px; background: red; border-radius: 50%; animation: pulse 2s infinite;"></span>
          Live-Ticker
        </h3>
        <% if (event.live_ticker) { %>
          <div style="font-family: monospace; white-space: pre-line; background: var(--fcz-cream); padding: 1rem; border-radius: var(--radius-sm); border-left: 4px solid var(--fcz-red);">
            <%- event.live_ticker %>
          </div>
        <% } else { %>
          <p style="color: var(--fcz-gray-500); font-style: italic;">Der Live-Ticker startet pünktlich zum Spielbeginn.</p>
        <% } %>
      </div>
      <style>
        @keyframes pulse {
          0% { box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.7); }
          70% { box-shadow: 0 0 0 10px rgba(255, 0, 0, 0); }
          100% { box-shadow: 0 0 0 0 rgba(255, 0, 0, 0); }
        }
      </style>
    <% } %>
    
    <div style="margin-top: 3rem;">
      <a href="/events" class="btn btn-outline">← Zurück zur Übersicht</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
