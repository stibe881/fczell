<% const pageTitle = 'Fotos verwalten'; const active = 'gallery'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1><%= gallery ? 'Galerie bearbeiten: "' + gallery.name + '"' : 'Neue Galerie erstellen' %></h1>
      <a class="link-arrow" href="/admin/gallery" style="margin-top: 0.5rem; display: inline-block;">← zurück zu allen Galerien</a>
    </div>
  </div>

  <div style="margin-bottom: 3rem; background: #fff; padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--fcz-gray-200);">
    <form class="admin-form" action="/admin/gallery/<%= gallery ? gallery.id + '/edit' : 'new-gallery' %>" method="post" style="max-width: 600px;">
      <h3 style="margin-bottom: 1rem;">Allgemeine Einstellungen</h3>
      
      <div class="form-group">
        <label for="name">Name der Galerie *</label>
        <input type="text" id="name" name="name" required value="<%= gallery ? gallery.name : '' %>" />
      </div>

      <div class="form-group">
        <label for="anlass_search">Zugeordneter Anlass</label>
        <input type="hidden" id="anlass_id" name="anlass_id" value="<%= gallery && gallery.anlass_id ? gallery.anlass_id : '' %>" />
        <div class="search-select" id="anlassSelect">
          <input type="text" id="anlass_search" class="search-select-input" placeholder="Anlass suchen..." autocomplete="off"
            value="<%= gallery && gallery.anlass_id ? anlaesse.find(a => a.id === gallery.anlass_id)?.title + (anlaesse.find(a => a.id === gallery.anlass_id)?.year ? ' (' + anlaesse.find(a => a.id === gallery.anlass_id).year + ')' : '') : '' %>" />
          <div class="search-select-dropdown" id="anlassDropdown">
            <div class="search-select-option" data-value="" onclick="selectAnlass('', '-- Keiner / Allgemein --')">
              <span style="color: var(--fcz-gray-500);">-- Keiner / Allgemein --</span>
            </div>
            <% anlaesse.forEach(a => { %>
              <div class="search-select-option" data-value="<%= a.id %>" onclick="selectAnlass('<%= a.id %>', '<%= a.title %><%= a.year ? ' (' + a.year + ')' : '' %>')">
                <span><%= a.title %></span>
                <% if (a.year) { %><small style="color: var(--fcz-gray-500); margin-left: 0.5rem;"><%= a.year %></small><% } %>
              </div>
            <% }) %>
          </div>
        </div>
        <small class="muted" style="display: block; margin-top: 0.25rem;">Tippe um zu filtern – wähle den Anlass, bei dem diese Fotos angezeigt werden sollen.</small>
      </div>

      <div class="form-group">
        <label for="sort_order">Reihenfolge (Sortierung)</label>
        <input type="number" id="sort_order" name="sort_order" value="<%= gallery ? gallery.sort_order : 0 %>" />
      </div>

      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>

  <hr style="border:0; border-top: 1px solid var(--fcz-gray-300); margin: 2rem 0;">

  <% if (gallery) { %>
  <!-- Foto-Upload Form -->
  <div style="margin-bottom: 2rem;">
    <h3 style="margin-bottom: 1rem;">Neue Fotos hinzufügen</h3>
    <form action="/admin/gallery/<%= gallery.id %>/photos" method="post" enctype="multipart/form-data" id="uploadForm">
      <div id="dropZone" style="border: 2px dashed #cbd5e1; border-radius: var(--radius); padding: 3rem 1.5rem; text-align: center; background: #f8fafc; cursor: pointer; transition: all 0.2s ease;">
        <input type="file" id="images" name="images" accept="image/*" multiple style="display: none;" onchange="handleFiles(this.files)" />
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem; color: var(--fcz-blue); opacity: 0.8;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        <p style="margin: 0; font-size: 1.1rem; color: #475569; font-weight: 500;">Bilder hierher ziehen oder klicken zum Auswählen</p>
        <p class="muted" style="margin-top: 0.5rem; color: #64748b;">Du kannst mehrere Bilder gleichzeitig markieren.</p>
      </div>
      
      <div id="previewArea" style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;"></div>

      <button type="submit" id="submitBtn" class="btn btn-primary" style="margin-top: 1.5rem; display: none;">Hochladen starten</button>
    </form>
  </div>

  <script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('images');
    const submitBtn = document.getElementById('submitBtn');
    const previewArea = document.getElementById('previewArea');

    // Klicken triggert file input
    dropZone.addEventListener('click', () => fileInput.click());

    // Drag & Drop Styling
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults (e) {
      e.preventDefault();
      e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
      dropZone.style.borderColor = 'var(--fcz-blue)';
      dropZone.style.background = '#f0f9ff';
    }

    function unhighlight(e) {
      dropZone.style.borderColor = '#cbd5e1';
      dropZone.style.background = '#f8fafc';
    }

    dropZone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
      const dt = e.dataTransfer;
      const files = dt.files;
      fileInput.files = files; // Zuweisen der Files an das unsichtbare Input-Feld
      handleFiles(files);
    }

    function handleFiles(files) {
      if (files.length > 0) {
        submitBtn.style.display = 'inline-block';
        previewArea.innerHTML = '';
        
        // Kleine Vorschau der ausgewählten Bilder
        Array.from(files).forEach(file => {
          if (!file.type.startsWith('image/')) return;
          
          const reader = new FileReader();
          reader.onload = function(e) {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.width = '80px';
            img.style.height = '80px';
            img.style.objectFit = 'cover';
            img.style.borderRadius = '6px';
            img.style.border = '1px solid var(--fcz-gray-200)';
            previewArea.appendChild(img);
          }
          reader.readAsDataURL(file);
        });
      } else {
        submitBtn.style.display = 'none';
        previewArea.innerHTML = '';
      }
    }
  </script>

  <% if (photos.length === 0) { %>
    <p class="empty">Noch keine Fotos in dieser Galerie.</p>
  <% } else { %>
    <form action="/admin/gallery/<%= gallery.id %>/photos/bulk-delete" method="POST" id="bulkDeleteForm" onsubmit="return confirm('Ausgewählte Fotos wirklich löschen?');">
      <div style="margin-bottom: 2rem; padding: 1rem; background: var(--fcz-gray-100); border-radius: var(--radius); display: flex; gap: 1rem; align-items: center;">
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="document.querySelectorAll('.photo-cb').forEach(cb => cb.checked = true)">Alle markieren</button>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="document.querySelectorAll('.photo-cb').forEach(cb => cb.checked = false)">Auswahl aufheben</button>
        <button type="submit" class="btn btn-sm btn-danger">Ausgewählte löschen</button>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
        <% photos.forEach(photo => { %>
          <div class="gallery-item" style="position: relative; width: 150px;">
            <input type="checkbox" name="photoIds" value="<%= photo.id %>" class="photo-cb" style="position: absolute; top: 8px; left: 8px; transform: scale(1.5); cursor: pointer; z-index: 10;" />
            <img src="<%= photo.image_path %>" alt="<%= photo.alt_text || '' %>"
                 style="width: 150px; height: 150px; object-fit: cover; border-radius: 6px 6px 0 0; border: 1px solid var(--fcz-gray-300); cursor: pointer; transition: opacity 0.2s;" 
                 onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'"
                 onclick="const cb = this.parentElement.querySelector('.photo-cb'); cb.checked = !cb.checked;" />
            <div style="background: #fff; border: 1px solid var(--fcz-gray-300); border-top: none; border-radius: 0 0 6px 6px; padding: 0.4rem;">
              <div class="alt-display" id="alt-display-<%= photo.id %>" onclick="editAltText(<%= photo.id %>)" style="cursor: pointer; font-size: 0.72rem; color: var(--fcz-gray-500); min-height: 1.4em; display: flex; align-items: center; gap: 0.25rem;" title="Alt-Text bearbeiten">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span><%= photo.alt_text || 'Alt-Text hinzufügen' %></span>
              </div>
              <div class="alt-edit" id="alt-edit-<%= photo.id %>" style="display: none;">
                <input type="text" value="<%= photo.alt_text || '' %>" placeholder="Bildbeschreibung..." style="width: 100%; font-size: 0.75rem; padding: 0.2rem 0.35rem; border: 1px solid var(--fcz-red); border-radius: 3px;" onkeydown="if(event.key==='Enter'){event.preventDefault();saveAltText(<%= photo.id %>, this.value);} if(event.key==='Escape') cancelAltEdit(<%= photo.id %>);" />
                <div style="display: flex; gap: 0.25rem; margin-top: 0.25rem;">
                  <button type="button" onclick="saveAltText(<%= photo.id %>, this.parentElement.previousElementSibling.value)" style="flex:1; font-size: 0.65rem; padding: 0.15rem; background: var(--fcz-red); color: #fff; border: none; border-radius: 3px; cursor: pointer;">✓</button>
                  <button type="button" onclick="cancelAltEdit(<%= photo.id %>)" style="flex:1; font-size: 0.65rem; padding: 0.15rem; background: var(--fcz-gray-300); border: none; border-radius: 3px; cursor: pointer;">✗</button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </form>

    <script>
    function editAltText(id) {
      document.getElementById('alt-display-' + id).style.display = 'none';
      var editDiv = document.getElementById('alt-edit-' + id);
      editDiv.style.display = 'block';
      editDiv.querySelector('input').focus();
    }
    function cancelAltEdit(id) {
      document.getElementById('alt-edit-' + id).style.display = 'none';
      document.getElementById('alt-display-' + id).style.display = 'flex';
    }
    function saveAltText(id, val) {
      fetch('/admin/gallery/<%= gallery.id %>/photos/' + id + '/alt-text', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ alt_text: val })
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.success) {
          var display = document.getElementById('alt-display-' + id);
          display.querySelector('span').textContent = val || 'Alt-Text hinzufügen';
          display.querySelector('span').style.fontStyle = val ? 'normal' : 'italic';
          cancelAltEdit(id);
        } else {
          alert('Fehler beim Speichern');
        }
      }).catch(function() { alert('Fehler beim Speichern'); });
    }
    </script>
  <% } %>
  <% } else { %>
    <p class="muted">Speichere die Galerie zuerst, bevor du Fotos hochladen kannst.</p>
  <% } %>
</div>

<style>
.search-select {
  position: relative;
}
.search-select-input {
  width: 100%;
  padding: 0.6rem 0.75rem;
  border: 1px solid var(--fcz-gray-300);
  border-radius: var(--radius);
  font-size: 0.95rem;
  background: #fff;
  transition: border-color 0.2s;
}
.search-select-input:focus {
  outline: none;
  border-color: var(--fcz-red);
  box-shadow: 0 0 0 3px rgba(200,16,46,0.1);
}
.search-select-dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  z-index: 100;
  max-height: 280px;
  overflow-y: auto;
  background: #fff;
  border: 1px solid var(--fcz-gray-300);
  border-top: none;
  border-radius: 0 0 var(--radius) var(--radius);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}
.search-select.open .search-select-dropdown {
  display: block;
}
.search-select.open .search-select-input {
  border-radius: var(--radius) var(--radius) 0 0;
}
.search-select-option {
  display: flex;
  align-items: center;
  padding: 0.6rem 0.75rem;
  cursor: pointer;
  font-size: 0.92rem;
  transition: background 0.15s;
}
.search-select-option:hover {
  background: rgba(200,16,46,0.06);
}
.search-select-option.hidden {
  display: none;
}
</style>

<script>
(function() {
  const wrapper = document.getElementById('anlassSelect');
  const input = document.getElementById('anlass_search');
  const hidden = document.getElementById('anlass_id');
  const dropdown = document.getElementById('anlassDropdown');
  const options = dropdown.querySelectorAll('.search-select-option');

  input.addEventListener('focus', function() {
    wrapper.classList.add('open');
    this.select();
  });

  input.addEventListener('input', function() {
    const q = this.value.toLowerCase();
    options.forEach(opt => {
      const text = opt.textContent.toLowerCase();
      opt.classList.toggle('hidden', q && !text.includes(q));
    });
    wrapper.classList.add('open');
  });

  document.addEventListener('click', function(e) {
    if (!wrapper.contains(e.target)) {
      wrapper.classList.remove('open');
    }
  });

  window.selectAnlass = function(val, label) {
    hidden.value = val;
    input.value = val ? label : '';
    wrapper.classList.remove('open');
  };
})();
</script>

<%- include('_admin-footer') %>
