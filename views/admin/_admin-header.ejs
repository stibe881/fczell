<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · <%= typeof pageTitle !== 'undefined' ? pageTitle : 'FC Zell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/admin.css" />
  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body class="admin">
<header class="admin-header">
  <a href="/admin" class="admin-brand">
    <img src="/logo.png" alt="FC Zell Logo" class="brand-logo" />
    <span>Admin-Bereich</span>
  </a>
  <nav class="admin-nav">
    <%
      let roles = [];
      try {
        roles = JSON.parse(user.roles || '[]');
      } catch (e) {}
      const isAdmin = roles.includes('admin');
    %>
    <a href="/admin" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">Übersicht</a>
    
    <% if (isAdmin || roles.includes('news')) { %>
      <a href="/admin/news" class="<%= typeof active !== 'undefined' && active === 'news' ? 'active' : '' %>">News</a>
    <% } %>
    
    <% if (isAdmin || roles.includes('teams')) { %>
      <a href="/admin/events" class="<%= typeof active !== 'undefined' && active === 'events' ? 'active' : '' %>">Termine</a>
      <a href="/admin/teams" class="<%= typeof active !== 'undefined' && active === 'teams' ? 'active' : '' %>">Teams</a>
    <% } %>
    
    <% if (isAdmin || roles.includes('content')) { %>
      <a href="/admin/pages" class="<%= typeof active !== 'undefined' && active === 'pages' ? 'active' : '' %>">Inhalte</a>
      <a href="/admin/vorstand" class="<%= typeof active !== 'undefined' && active === 'vorstand' ? 'active' : '' %>">Vorstand</a>
      <a href="/admin/jobs" class="<%= typeof active !== 'undefined' && active === 'jobs' ? 'active' : '' %>">Jobs</a>
    <% } %>
    
    <% if (isAdmin || roles.includes('sponsoring')) { %>
      <a href="/admin/sponsors" class="<%= typeof active !== 'undefined' && active === 'sponsors' ? 'active' : '' %>">Sponsoren</a>
      <a href="/admin/advertisers" class="<%= typeof active !== 'undefined' && active === 'advertisers' ? 'active' : '' %>">Banden</a>
    <% } %>
    
    <% if (isAdmin) { %>
      <a href="/admin/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">Benutzer</a>
    <% } %>
    
    <a href="/admin/account" class="<%= typeof active !== 'undefined' && active === 'account' ? 'active' : '' %>">Konto</a>
  </nav>
  <div class="admin-meta">
    <a href="/" target="_blank" class="link-arrow">Webseite ansehen ↗</a>
    <span class="user-chip"><%= user.displayName || user.username %></span>
    <form action="/logout" method="post" style="display:inline">
      <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
    </form>
  </div>
</header>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status">
    <div class="flash-inner"><%= flash.msg %></div>
  </div>
<% } %>

<main class="admin-main">
