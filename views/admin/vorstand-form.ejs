<% const pageTitle = item ? 'Vorstandsmitglied bearbeiten' : 'Neues Vorstandsmitglied'; const active = 'vorstand'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= pageTitle %></h1>
    <a href="/admin/vorstand" class="link-arrow">← Zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/vorstand/<%= item ? item.id + '/edit' : 'new' %>" method="post" enctype="multipart/form-data">
    
    <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 1.5rem;">
      <div style="flex-shrink: 0; text-align: center; width: 140px;" class="admin-image-upload">
        <label style="display:block; margin-bottom: 0.5rem; font-weight: 600;">Porträt (optional)</label>
        <div id="photoPreviewContainer" style="width: 120px; height: 120px; border-radius: 50%; background: #f8fafc; display: flex; align-items: center; justify-content: center; overflow: hidden; margin: 0 auto 0.75rem; border: 2px dashed #cbd5e1; cursor: pointer; transition: all 0.2s ease;" onclick="document.getElementById('photoInput').click()" onmouseover="this.style.borderColor='var(--fcz-blue)'; this.style.backgroundColor='#f0f9ff';" onmouseout="this.style.borderColor='#cbd5e1'; this.style.backgroundColor='#f8fafc';">
          <% if (item && item.photo) { %>
            <img src="<%= item.photo %>" alt="Profilbild" style="width: 100%; height: 100%; object-fit: cover;" id="previewImg" />
            <div id="previewPlaceholder" style="display: none; flex-direction: column; align-items: center; gap: 0.25rem; color: #64748b;">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span style="font-size: 0.7rem;">Foto</span>
            </div>
          <% } else { %>
            <div id="previewPlaceholder" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; color: #64748b;">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span style="font-size: 0.7rem;">Foto</span>
            </div>
            <img src="" alt="" style="width: 100%; height: 100%; object-fit: cover; display: none;" id="previewImg" />
          <% } %>
        </div>
        <input type="file" name="vorstand_photo" id="photoInput" accept="image/*" class="admin-image-input" onchange="previewPhoto(this)" />
        <input type="hidden" name="delete_photo" id="deletePhotoField" value="0" />
        <div style="display: flex; gap: 0.5rem; justify-content: center;">
          <button type="button" id="deletePhotoBtn" onclick="deletePhoto()" class="admin-image-delete-btn" style="display: <%= item && item.photo ? 'flex' : 'none' %>; margin: 0 auto; justify-content: center;">✕ Löschen</button>
        </div>
      </div>

      <div style="flex: 1;">
        <div class="form-group">
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required />
        </div>
        <div class="form-group">
          <label for="role">Funktion/Rolle</label>
          <input type="text" id="role" name="role" value="<%= item ? item.role : '' %>" />
        </div>
      </div>
    </div>

    <div class="form-group">
      <label for="address">Adresse</label>
      <input type="text" id="address" name="address" value="<%= item ? item.address : '' %>" />
    </div>

    <div class="form-row" style="display: flex; gap: 1rem;">
      <div class="form-group" style="flex: 1;">
        <label for="phone">Telefon</label>
        <input type="text" id="phone" name="phone" value="<%= item ? item.phone : '' %>" />
      </div>
      <div class="form-group" style="flex: 1;">
        <label for="email">E-Mail</label>
        <input type="email" id="email" name="email" value="<%= item ? item.email : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung, kleine Zahl zuerst)</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= item ? item.sort_order : '0' %>" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg"><%= item ? 'Aktualisieren' : 'Speichern' %></button>
      <a class="btn btn-ghost" href="/admin/vorstand">Abbrechen</a>
    </div>
  </form>
</div>

<script>
function previewPhoto(input) {
  if (input.files && input.files[0]) {
    var reader = new FileReader();
    reader.onload = function(e) {
      var img = document.getElementById('previewImg');
      img.src = e.target.result;
      img.style.display = 'block';
      var placeholder = document.getElementById('previewPlaceholder');
      if (placeholder) placeholder.style.display = 'none';
      document.getElementById('deletePhotoField').value = '0';
    };
    reader.readAsDataURL(input.files[0]);
  }
}

function deletePhoto() {
  document.getElementById('deletePhotoField').value = '1';
  var img = document.getElementById('previewImg');
  img.src = '';
  img.style.display = 'none';
  var placeholder = document.getElementById('previewPlaceholder');
  if (!placeholder) {
    var container = document.getElementById('photoPreview');
    var div = document.createElement('div');
    div.id = 'previewPlaceholder';
    div.style.cssText = 'display: flex; flex-direction: column; align-items: center; gap: 0.25rem; color: var(--fcz-gray-500);';
    div.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span style="font-size: 0.7rem;">Foto</span>';
    container.appendChild(div);
  } else {
    placeholder.style.display = 'flex';
  }
  var btn = document.getElementById('deletePhotoBtn');
  if (btn) btn.style.display = 'none';
  document.getElementById('photoInput').value = '';
}
</script>

<%- include('_admin-footer') %>
