<% const pageTitle = 'Übersicht'; const active = 'dashboard'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <div>
      <h1>Willkommen, <%= user.displayName || user.username %></h1>
      <p>Hier verwaltest du Inhalte des FC Zell.</p>
    </div>
    <%
      let roles = [];
      try { roles = JSON.parse(user.roles || '[]'); } catch (e) {}
      const isAdmin = roles.includes('admin');
    %>
    <div class="admin-quick-actions">
      <% if (isAdmin || roles.includes('news')) { %>
        <a class="btn btn-primary" href="/admin/news/new">+ News erfassen</a>
      <% } %>
      <% if (isAdmin || roles.includes('teams')) { %>
        <a class="btn btn-outline-dark" href="/admin/events/new">+ Termin erfassen</a>
      <% } %>
    </div>
  </div>

  <ul class="stat-row">
    <% if (isAdmin || roles.includes('news')) { %>
    <li>
      <span class="stat-num"><%= newsCount %></span>
      <span class="stat-label">News-Beiträge</span>
      <a href="/admin/news">verwalten →</a>
    </li>
    <% } %>
    <% if (isAdmin || roles.includes('teams')) { %>
    <li>
      <span class="stat-num"><%= eventsCount %></span>
      <span class="stat-label">Termine</span>
      <a href="/admin/events">verwalten →</a>
    </li>
    <li>
      <span class="stat-num"><%= teamsCount %></span>
      <span class="stat-label">Teams</span>
      <a href="/admin/teams">verwalten →</a>
    </li>
    <% } %>
    <% if (isAdmin || roles.includes('content')) { %>
    <li>
      <span class="stat-num"><%= pagesCount %></span>
      <span class="stat-label">Inhalts-Bausteine</span>
      <a href="/admin/pages">verwalten →</a>
    </li>
    <li>
      <span class="stat-num"><%= vorstandCount %></span>
      <span class="stat-label">Vorstand</span>
      <a href="/admin/vorstand">verwalten →</a>
    </li>
    <% } %>
    <% if (isAdmin || roles.includes('sponsoring')) { %>
    <li>
      <span class="stat-num"><%= sponsorsCount %></span>
      <span class="stat-label">Sponsoren</span>
      <a href="/admin/sponsors">verwalten →</a>
    </li>
    <li>
      <span class="stat-num"><%= advertisersCount %></span>
      <span class="stat-label">Bandenwerber</span>
      <a href="/admin/advertisers">verwalten →</a>
    </li>
    <% } %>
    <% if (isAdmin || roles.includes('content')) { %>
    <li>
      <span class="stat-num"><%= documentsCount %></span>
      <span class="stat-label">Dokumente</span>
      <a href="/admin/documents">verwalten →</a>
    </li>
    <li>
      <span class="stat-num"><%= galleryCount %></span>
      <span class="stat-label">Galerie-Fotos</span>
      <a href="/admin/gallery">verwalten →</a>
    </li>
    <% } %>
    <% if (isAdmin) { %>
    <li>
      <span class="stat-num"><%= regJuniorenlager %></span>
      <span class="stat-label">Anmeldungen Lager</span>
      <a href="/admin/registrations/juniorenlager">ansehen →</a>
    </li>
    <li>
      <span class="stat-num"><%= regDorfturnier %></span>
      <span class="stat-label">Anmeldungen Turnier</span>
      <a href="/admin/registrations/dorfturnier">ansehen →</a>
    </li>
    <% } %>
  </ul>

  <div class="admin-cols">
    <% if (isAdmin || roles.includes('news')) { %>
    <section>
      <h2>Letzte News</h2>
      <% if (recentNews.length === 0) { %>
        <p class="empty">Noch keine News erfasst.</p>
      <% } else { %>
        <ul class="admin-list">
          <% recentNews.forEach(n => { %>
            <li>
              <div>
                <strong><%= n.title %></strong>
                <span class="muted"><%= formatDate(n.published_at) %> · <%= n.category %></span>
              </div>
              <a href="/admin/news/<%= n.id %>/edit">bearbeiten</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
    <% } %>

    <% if (isAdmin || roles.includes('teams')) { %>
    <section>
      <h2>Kommende Termine</h2>
      <% if (upcomingEvents.length === 0) { %>
        <p class="empty">Keine bevorstehenden Termine.</p>
      <% } else { %>
        <ul class="admin-list">
          <% upcomingEvents.forEach(ev => { %>
            <li>
              <div>
                <strong><%= ev.title %></strong>
                <span class="muted"><%= formatDate(ev.event_date) %><%= ev.event_time ? ' · ' + ev.event_time : '' %></span>
              </div>
              <a href="/admin/events/<%= ev.id %>/edit">bearbeiten</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
    <% } %>
  </div>
</div>

<%- include('_admin-footer') %>
