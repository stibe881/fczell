<% const pageTitle = 'Vorstand verwalten'; const active = 'vorstand'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1>Vorstand</h1>
    <a class="btn btn-primary" href="/admin/vorstand/new">+ Neues Mitglied</a>
  </div>

  <% if (items.length === 0) { %>
    <p class="empty">Noch keine Vorstandsmitglieder erfasst.</p>
  <% } else { %>
    <table class="admin-table" id="adminVorstandTable">
      <thead>
        <tr>
          <th class="sortable" data-sort="sort_order" style="cursor: pointer; user-select: none;">Reihenfolge <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="sortable" data-sort="name" style="cursor: pointer; user-select: none;">Name <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="sortable" data-sort="role" style="cursor: pointer; user-select: none;">Rolle <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th>Kontakt</th>
          <th class="actions">Aktionen</th>
        </tr>
      </thead>
      <tbody id="adminVorstandTbody">
        <% items.forEach(v => { %>
          <tr class="vorstand-row" 
              data-sort_order="<%= v.sort_order %>" 
              data-name="<%= v.name.toLowerCase() %>" 
              data-role="<%= v.role.toLowerCase() %>">
            <td><%= v.sort_order %></td>
            <td><strong><%= v.name %></strong></td>
            <td><%= v.role %></td>
            <td>
              <%= v.phone %><br>
              <small class="muted"><%= v.email %></small>
            </td>
            <td class="actions">
              <a class="btn btn-sm btn-primary" href="/admin/vorstand/<%= v.id %>/edit">Bearbeiten</a>
              <form action="/admin/vorstand/<%= v.id %>/delete" method="post" onsubmit="return confirm('Wirklich löschen?');" style="display:inline">
                <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
  // Table Sorting Logic
  const tableBody = document.getElementById('adminVorstandTbody');
  const headers = document.querySelectorAll('.sortable');
  let currentSort = { column: null, asc: true };

  if (headers.length > 0) {
    headers.forEach(header => {
      header.addEventListener('click', () => {
        const column = header.getAttribute('data-sort');
        const asc = currentSort.column === column ? !currentSort.asc : true;
        currentSort = { column, asc };

        // Update UI Icons
        headers.forEach(h => {
          const icon = h.querySelector('.sort-icon');
          if (icon) {
            icon.innerHTML = '↕';
            icon.style.opacity = '0.3';
            icon.style.color = 'inherit';
          }
        });
        const currentIcon = header.querySelector('.sort-icon');
        if (currentIcon) {
          currentIcon.innerHTML = asc ? '↓' : '↑';
          currentIcon.style.opacity = '1';
          currentIcon.style.color = 'var(--fcz-red)';
        }

        // Sort rows
        const rows = Array.from(tableBody.querySelectorAll('.vorstand-row'));
        rows.sort((a, b) => {
          let valA = a.getAttribute(`data-${column}`);
          let valB = b.getAttribute(`data-${column}`);

          // Numeric parsing for sort_order
          if (column === 'sort_order') {
            valA = parseInt(valA) || 0;
            valB = parseInt(valB) || 0;
          }

          if (valA < valB) return asc ? -1 : 1;
          if (valA > valB) return asc ? 1 : -1;
          return 0;
        });

        // Re-append rows
        rows.forEach(row => tableBody.appendChild(row));
      });
    });
  }
</script>

<%- include('_admin-footer') %>
