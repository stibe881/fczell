<% const pageTitle = 'Neues Foto'; const active = 'gallery'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1>Neues Foto</h1>
    <a class="link-arrow" href="/admin/gallery">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/gallery/new" method="post" enctype="multipart/form-data">
    <div class="form-group">
      <label for="gallery">Galerie *</label>
      <input type="text" id="gallery" name="gallery" required list="gallery-list" value="<%= typeof gallery !== 'undefined' && gallery ? gallery : '' %>" />
      <datalist id="gallery-list">
        <option value="juniorenlager"></option>
        <option value="dorfturnier"></option>
        <option value="sponsorentafel"></option>
        <option value="team-1-mannschaft"></option>
        <option value="team-2-mannschaft"></option>
        <option value="team-senioren"></option>
        <option value="team-junioren"></option>
      </datalist>
    </div>

    <div class="form-group">
      <label for="image">Bild hochladen *</label>
      <input type="file" id="image" name="image" accept="image/*" required />
    </div>

    <div class="form-group">
      <label for="caption">Bildunterschrift</label>
      <input type="text" id="caption" name="caption" />
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung, kleine Zahl zuerst)</label>
      <input type="number" id="sort_order" name="sort_order" value="0" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg">Hochladen</button>
      <a class="btn btn-ghost" href="/admin/gallery">Abbrechen</a>
    </div>
  </form>
</div>

<%- include('_admin-footer') %>
