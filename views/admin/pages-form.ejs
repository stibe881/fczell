<% const pageTitle = 'Inhalt bearbeiten'; const active = 'pages'; %>
<%- include('_admin-header') %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
<style>
  .ql-editor { min-height: 300px; font-family: 'Inter', sans-serif; font-size: 1rem; line-height: 1.7; }
  .ql-toolbar.ql-snow { background: var(--fcz-gray-100, #f5f5f5); border-radius: 6px 6px 0 0; border-color: var(--fcz-gray-300, #d6d6d6); }
  .ql-container.ql-snow { border-radius: 0 0 6px 6px; border-color: var(--fcz-gray-300, #d6d6d6); }
  .editor-tabs { display: flex; gap: 0; margin-bottom: 0; }
  .editor-tab { padding: 0.6rem 1.2rem; background: var(--fcz-gray-100, #f5f5f5); border: 1px solid var(--fcz-gray-300, #d6d6d6); border-bottom: 0; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--fcz-gray-700, #444); transition: all 0.2s; }
  .editor-tab:first-child { border-radius: 6px 0 0 0; }
  .editor-tab:last-child { border-radius: 0 6px 0 0; }
  .editor-tab.active { background: #fff; color: var(--fcz-red, #1a80b6); border-bottom-color: #fff; }
  .editor-source { display: none; }
  .editor-source textarea { width: 100%; min-height: 350px; padding: 1rem; border: 1px solid var(--fcz-gray-300, #d6d6d6); border-radius: 0 0 6px 6px; font-family: 'Courier New', monospace; font-size: 0.9rem; line-height: 1.6; resize: vertical; }
  .editor-hint { margin-top: 0.5rem; font-size: 0.82rem; color: var(--fcz-gray-500, #777); }
</style>

<div class="admin-content">
  <div class="admin-page-head">
    <h1>Inhalt bearbeiten</h1>
    <a class="link-arrow" href="/admin/pages">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/pages/<%= item.id %>/edit" method="post" id="pageForm">
    <p class="muted">Slug: <code><%= item.slug %></code></p>
    <label>
      <span>Titel *</span>
      <input name="title" required value="<%= item.title %>" />
    </label>

    <div style="margin-top: 0.5rem;">
      <span style="font-size: 0.9rem; font-weight: 500; color: var(--fcz-gray-700, #444);">Inhalt *</span>
      
      <div class="editor-tabs">
        <button type="button" class="editor-tab active" id="tabVisual" onclick="switchTab('visual')">Visuell</button>
        <button type="button" class="editor-tab" id="tabSource" onclick="switchTab('source')">Markdown</button>
      </div>

      <div id="editorVisual">
        <div id="quillEditor"></div>
      </div>

      <div class="editor-source" id="editorSource">
        <textarea id="sourceTextarea"><%= item.body %></textarea>
      </div>

      <!-- Hidden field that gets submitted -->
      <input type="hidden" name="body" id="bodyField" value="" />

      <p class="editor-hint">
        <strong>Visuell:</strong> Text direkt formatieren. <strong>Markdown:</strong> <code>**fett**</code>, <code>*kursiv*</code>, Listen mit <code>- Eintrag</code>, Absätze durch Leerzeile.
      </p>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-lg" type="submit">Speichern</button>
      <a class="btn btn-ghost" href="/admin/pages">Abbrechen</a>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  const originalBody = document.getElementById('sourceTextarea').value;
  let currentMode = 'visual';

  // Convert simple markdown to HTML for Quill
  function mdToEditorHtml(md) {
    if (!md) return '';
    const blocks = md.split(/\n{2,}/).map(b => b.trim()).filter(Boolean);
    return blocks.map(block => {
      const lines = block.split('\n');
      if (lines.every(l => /^[-*]\s+/.test(l))) {
        return '<ul>' + lines.map(l => '<li>' + inlineFormat(l.replace(/^[-*]\s+/, '')) + '</li>').join('') + '</ul>';
      }
      return '<p>' + inlineFormat(block).replace(/\n/g, '<br>') + '</p>';
    }).join('');
  }

  function inlineFormat(s) {
    return s
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>');
  }

  // Convert Quill HTML back to simple markdown
  function htmlToMd(html) {
    const div = document.createElement('div');
    div.innerHTML = html;
    let md = '';
    div.childNodes.forEach(node => {
      if (node.nodeType === 3) {
        md += node.textContent;
        return;
      }
      const tag = (node.tagName || '').toLowerCase();
      if (tag === 'p') {
        const text = nodeToMd(node);
        if (text.trim()) md += text + '\n\n';
      } else if (tag === 'ul' || tag === 'ol') {
        node.querySelectorAll('li').forEach(li => {
          md += '- ' + nodeToMd(li) + '\n';
        });
        md += '\n';
      } else if (tag === 'h1' || tag === 'h2' || tag === 'h3') {
        md += '**' + node.textContent + '**\n\n';
      } else {
        const text = nodeToMd(node);
        if (text.trim()) md += text + '\n\n';
      }
    });
    return md.replace(/\n{3,}/g, '\n\n').trim();
  }

  function nodeToMd(node) {
    let result = '';
    node.childNodes.forEach(child => {
      if (child.nodeType === 3) {
        result += child.textContent;
      } else {
        const tag = (child.tagName || '').toLowerCase();
        const inner = nodeToMd(child);
        if (tag === 'strong' || tag === 'b') result += '**' + inner + '**';
        else if (tag === 'em' || tag === 'i') result += '*' + inner + '*';
        else if (tag === 'br') result += '\n';
        else result += inner;
      }
    });
    return result;
  }

  // Initialize Quill
  const quill = new Quill('#quillEditor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ 'header': [2, 3, false] }],
        ['bold', 'italic', 'underline'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        ['link'],
        ['clean']
      ]
    },
    placeholder: 'Inhalt eingeben...'
  });

  // Load initial content
  const initialHtml = mdToEditorHtml(originalBody);
  quill.root.innerHTML = initialHtml;

  // Tab switching
  function switchTab(mode) {
    if (mode === currentMode) return;

    if (mode === 'source') {
      // Visual -> Source: convert Quill HTML to markdown
      const md = htmlToMd(quill.root.innerHTML);
      document.getElementById('sourceTextarea').value = md;
      document.getElementById('editorVisual').style.display = 'none';
      document.getElementById('editorSource').style.display = 'block';
      document.getElementById('tabVisual').classList.remove('active');
      document.getElementById('tabSource').classList.add('active');
    } else {
      // Source -> Visual: convert markdown to HTML and load into Quill
      const md = document.getElementById('sourceTextarea').value;
      quill.root.innerHTML = mdToEditorHtml(md);
      document.getElementById('editorVisual').style.display = 'block';
      document.getElementById('editorSource').style.display = 'none';
      document.getElementById('tabVisual').classList.remove('active');
      document.getElementById('tabSource').classList.add('active');
      document.getElementById('tabVisual').classList.add('active');
      document.getElementById('tabSource').classList.remove('active');
    }
    currentMode = mode;
  }

  // On form submit, set the hidden body field
  document.getElementById('pageForm').addEventListener('submit', function() {
    if (currentMode === 'visual') {
      document.getElementById('bodyField').value = htmlToMd(quill.root.innerHTML);
    } else {
      document.getElementById('bodyField').value = document.getElementById('sourceTextarea').value;
    }
  });
</script>

<%- include('_admin-footer') %>
