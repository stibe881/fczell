<% const pageTitle = item ? 'Sponsor bearbeiten' : 'Neuer Sponsor'; const active = 'sponsors'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= pageTitle %></h1>
    <a href="/admin/sponsors" class="link-arrow">← Zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/sponsors/<%= item ? item.id + '/edit' : 'new' %>" method="post" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Name *</label>
      <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required />
    </div>

    <div class="form-group">
      <label for="category">Kategorie (z.B. Hauptsponsor, Co-Sponsor)</label>
      <input type="text" id="category" name="category" value="<%= item ? item.category : '' %>" />
    </div>

    <div class="form-group" style="margin-top: 1rem;">
      <label>Logo (Bilddatei hochladen)</label>
      <div class="admin-image-upload full-width">
        <% if (item && item.logo && !item.logo.startsWith('http')) { %>
          <div class="admin-image-preview" id="logo-preview-container">
            <img id="logo-preview" src="<%= item.logo %>" alt="Aktuelles Logo" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('logo-preview').src=''; document.getElementById('logo-preview-container').style.display='none';">✕ Entfernen</button>
          </div>
        <% } else { %>
          <div class="admin-image-preview" id="logo-preview-container" style="display: none;">
            <img id="logo-preview" src="" alt="Vorschau" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('logo-preview').src=''; document.getElementById('logo-preview-container').style.display='none'; document.getElementById('logo_file').value=''; document.getElementById('logo-filename').textContent='Neues Logo auswählen...';">✕ Entfernen</button>
          </div>
        <% } %>
        <label class="admin-image-label" onclick="document.getElementById('logo_file').click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span id="logo-filename">Neues Logo auswählen...</span>
        </label>
        <input type="file" name="logo_file" id="logo_file" accept="image/*" class="admin-image-input" onchange="
          const file = this.files[0];
          const nameSpan = document.getElementById('logo-filename');
          const previewCont = document.getElementById('logo-preview-container');
          const previewImg = document.getElementById('logo-preview');
          if(file) {
            nameSpan.textContent = file.name;
            previewCont.style.display = 'flex';
            previewImg.src = URL.createObjectURL(file);
          } else {
            nameSpan.textContent = 'Neues Logo auswählen...';
            previewCont.style.display = '<%- (item && item.logo && !item.logo.startsWith(\'http\')) ? 'flex' : 'none' %>';
            previewImg.src = '<%- (item && item.logo && !item.logo.startsWith(\'http\')) ? item.logo : '' %>';
          }
        " />
        <small class="muted" style="margin-top: 0.25rem;">Erlaubt: JPG, PNG, WEBP, GIF, SVG. Ein neues Bild überschreibt das bestehende.</small>
      </div>
      
      <div style="margin-top: 1rem;">
        <label for="logo" style="font-weight:normal; font-size: 0.9rem;">Oder ext. URL angeben (wird überschrieben wenn Datei hochgeladen):</label>
        <input type="text" id="logo" name="logo" value="<%= item && item.logo && item.logo.startsWith('http') ? item.logo : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="link">Webseite Link (inkl. https://)</label>
      <input type="url" id="link" name="link" value="<%= item ? item.link : '' %>" />
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung, kleine Zahl zuerst)</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= item ? item.sort_order : '0' %>" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg"><%= item ? 'Aktualisieren' : 'Speichern' %></button>
    </div>
  </form>
</div>

<%- include('_admin-footer') %>
