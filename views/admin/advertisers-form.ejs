<% 
  const isEdit = !!item;
  const pageTitle = isEdit ? 'Bandenwerber bearbeiten' : 'Neuer Bandenwerber';
  const active = 'advertisers';
%>
<%- include('_admin-header') %>

<div class="admin-content" style="max-width: 600px;">
  <div class="admin-page-head">
    <h1><%= pageTitle %></h1>
  </div>

  <form class="admin-form" action="/admin/advertisers/<%= isEdit ? item.id + '/edit' : 'new' %>" method="post" enctype="multipart/form-data">
    <div class="form-group">
      <label>Name des Bandenwerbers (Pflichtfeld)</label>
      <input type="text" name="name" value="<%= isEdit ? item.name : '' %>" required />
    </div>

    <div class="form-group">
      <label>Webseite (Link, optional)</label>
      <input type="url" name="link" value="<%= isEdit ? item.link : '' %>" placeholder="https://..." />
    </div>

    <div class="form-group">
      <label>Ort (optional)</label>
      <input type="text" name="location" value="<%= isEdit ? item.location : '' %>" />
    </div>

    <div class="form-group" style="margin-top: 1rem;">
      <label>Logo (Bilddatei, optional)</label>
      <% if (isEdit && item.logo) { %>
        <input type="hidden" name="existing_logo" value="<%= item.logo %>" />
      <% } %>
      <div class="admin-image-upload full-width">
        <% if (isEdit && item.logo) { %>
          <div class="admin-image-preview" id="logo-preview-container">
            <img id="logo-preview" src="<%= item.logo %>" alt="Aktuelles Logo" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('logo-preview').src=''; document.getElementById('logo-preview-container').style.display='none';">✕ Entfernen</button>
          </div>
        <% } else { %>
          <div class="admin-image-preview" id="logo-preview-container" style="display: none;">
            <img id="logo-preview" src="" alt="Vorschau" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('logo-preview').src=''; document.getElementById('logo-preview-container').style.display='none'; document.getElementById('logo-input').value=''; document.getElementById('logo-filename').textContent='Neues Logo auswählen...';">✕ Entfernen</button>
          </div>
        <% } %>
        <label class="admin-image-label" onclick="document.getElementById('logo-input').click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span id="logo-filename">Neues Logo auswählen...</span>
        </label>
        <input type="file" name="logo" id="logo-input" accept="image/png, image/jpeg, image/webp, image/svg+xml, image/gif" class="admin-image-input" onchange="
          const file = this.files[0];
          const nameSpan = document.getElementById('logo-filename');
          const previewCont = document.getElementById('logo-preview-container');
          const previewImg = document.getElementById('logo-preview');
          if(file) {
            nameSpan.textContent = file.name;
            previewCont.style.display = 'flex';
            previewImg.src = URL.createObjectURL(file);
          } else {
            nameSpan.textContent = 'Neues Logo auswählen...';
            previewCont.style.display = '<%- isEdit && item.logo ? 'flex' : 'none' %>';
            previewImg.src = '<%- isEdit && item.logo ? item.logo : '' %>';
          }
        " />
        <small class="muted" style="margin-top: 0.25rem;">Erlaubt: PNG, JPG, WEBP, SVG, GIF.</small>
      </div>
    </div>

    <div style="background: var(--fcz-gray-50); padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--fcz-gray-200); margin: 1rem 0;">
      <h3 style="font-size: 1.1rem; margin-top: 0; margin-bottom: 1rem; font-weight: 600;">Sichtbarkeit & Archivierung</h3>
      <div class="admin-cols" style="gap: 1rem; margin-bottom: 1rem; align-items: start;">
        <div class="form-group" style="margin: 0; display: flex; flex-direction: column;">
          <label for="active_from" style="white-space: nowrap;">Sichtbar ab</label>
          <input type="date" id="active_from" name="active_from" value="<%= isEdit && item.active_from ? item.active_from : '' %>" />
          <small style="margin-top: 0.5rem;">Wenn leer, sofort auf der Webseite aktiv.</small>
        </div>
        <div class="form-group" style="margin: 0; display: flex; flex-direction: column;">
          <label for="active_until" style="white-space: nowrap;">Sichtbar bis</label>
          <input type="date" id="active_until" name="active_until" value="<%= isEdit && item.active_until ? item.active_until : '' %>" />
          <small style="margin-top: 0.5rem;">Wird nach diesem Datum automatisch archiviert.</small>
        </div>
      </div>
      <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin: 0;">
        <input type="checkbox" id="is_archived" name="is_archived" value="1" <%= isEdit && item.is_archived ? 'checked' : '' %> style="width: auto;" />
        <label for="is_archived" style="margin: 0; color: var(--fcz-red-dark); font-weight: 600;">Manuell archivieren (Sofort verbergen)</label>
      </div>
    </div>

    <div class="form-actions">
      <a class="btn btn-outline" href="/admin/advertisers">Abbrechen</a>
      <button class="btn btn-primary" type="submit">Speichern</button>
    </div>
  </form>
</div>



<%- include('_admin-footer') %>
