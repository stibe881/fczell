<% const pageTitle = item ? 'Team bearbeiten' : 'Neues Team'; const active = 'teams'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= pageTitle %></h1>
    <a href="/admin/teams" class="link-arrow">← Zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/teams/<%= item ? item.id + '/edit' : 'new' %>" method="post" enctype="multipart/form-data">
    <div class="form-group">
      <label for="type">Team Typ *</label>
      <select id="type" name="type" required>
        <option value="aktive" <%= item && item.type === 'aktive' ? 'selected' : '' %>>Aktive</option>
        <option value="junioren" <%= item && item.type === 'junioren' ? 'selected' : '' %>>Junioren</option>
      </select>
    </div>

    <div class="form-group">
      <label for="name">Name (z.B. 1. Mannschaft) *</label>
      <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required />
    </div>

    <div class="form-group">
      <label for="slug">Slug (URL-Pfad, z.B. 1-mannschaft) *</label>
      <input type="text" id="slug" name="slug" value="<%= item ? item.slug : '' %>" required />
    </div>

    <div class="form-group">
      <label for="league">Liga (z.B. 3. Liga, Gruppe 3)</label>
      <input type="text" id="league" name="league" value="<%= item ? item.league : '' %>" />
    </div>

    <div class="form-group">
      <label for="extra">Zusatz (z.B. IFV) / Kontakt bei Junioren</label>
      <input type="text" id="extra" name="extra" value="<%= item ? item.extra : '' %>" />
    </div>

    <div class="form-group">
      <label>Staff (Trainer, Co-Trainer, Physio, etc.)</label>
      <div id="staff-container" style="display:flex; flex-direction:column; gap:1rem;">
        <% if (item && item.staff && item.staff.length > 0) { %>
          <% item.staff.forEach((s, idx) => { %>
            <div class="staff-row" style="display:flex; gap:0.5rem; align-items:center; background:#f9f9f9; padding:0.5rem; border:1px solid #ddd; border-radius:4px;">
              <select name="staff_role[]" style="width:150px;">
                <option value="Trainer" <%= s.role === 'Trainer' ? 'selected' : '' %>>Trainer</option>
                <option value="Co-Trainer" <%= s.role === 'Co-Trainer' ? 'selected' : '' %>>Co-Trainer</option>
                <option value="Torhütertrainer" <%= s.role === 'Torhütertrainer' ? 'selected' : '' %>>Torhütertrainer</option>
                <option value="Physio" <%= s.role === 'Physio' ? 'selected' : '' %>>Physio</option>
              </select>
              <input type="text" name="staff_name[]" value="<%= s.name %>" placeholder="Name" style="flex:1;" />
              
              <div style="width:250px;">
                <input type="hidden" name="staff_existing_photo[]" value="<%= s.photo %>" />
                <% if (s.photo) { %>
                  <img src="<%= s.photo %>" style="height:30px; border-radius:4px; vertical-align:middle; margin-right:5px;" />
                <% } %>
                <input type="file" name="staff_photo_<%= idx %>" accept="image/*" style="width:160px; font-size:0.8rem;" />
              </div>
              <button type="button" class="btn btn-ghost" onclick="this.parentElement.remove()" style="padding:0.25rem 0.5rem; color:red;">X</button>
            </div>
          <% }) %>
        <% } %>
      </div>
      <button type="button" class="btn btn-outline" onclick="addStaffRow()" style="margin-top:0.5rem;">+ Person hinzufügen</button>
    </div>

    <script>
      function addStaffRow() {
        const container = document.getElementById('staff-container');
        const count = container.children.length;
        const row = document.createElement('div');
        row.className = 'staff-row';
        row.style.cssText = 'display:flex; gap:0.5rem; align-items:center; background:#f9f9f9; padding:0.5rem; border:1px solid #ddd; border-radius:4px;';
        row.innerHTML = `
          <select name="staff_role[]" style="width:150px;">
            <option value="Trainer">Trainer</option>
            <option value="Co-Trainer">Co-Trainer</option>
            <option value="Torhütertrainer">Torhütertrainer</option>
            <option value="Physio">Physio</option>
          </select>
          <input type="text" name="staff_name[]" placeholder="Name" style="flex:1;" />
          <div style="width:250px;">
            <input type="hidden" name="staff_existing_photo[]" value="" />
            <input type="file" name="staff_photo_${count}" accept="image/*" style="width:160px; font-size:0.8rem;" />
          </div>
          <button type="button" class="btn btn-ghost" onclick="this.parentElement.remove()" style="padding:0.25rem 0.5rem; color:red;">X</button>
        `;
        container.appendChild(row);
      }
      
      // Add one empty row by default if empty
      if (document.getElementById('staff-container').children.length === 0) {
        addStaffRow();
      }
    </script>

    <div class="form-group">
      <label for="times">Trainingszeiten</label>
      <textarea id="times" name="times" rows="3"><%= item ? item.times : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Trainingsort</label>
      <input type="text" id="location" name="location" value="<%= item ? item.location : '' %>" />
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung, kleine Zahl zuerst)</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= item ? item.sort_order : '0' %>" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg"><%= item ? 'Aktualisieren' : 'Speichern' %></button>
    </div>
  </form>
</div>

<%- include('_admin-footer') %>
