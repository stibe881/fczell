<% const pageTitle = item ? 'Match bearbeiten' : 'Neues Match'; const active = 'events'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= item ? 'Match bearbeiten' : 'Neues Match' %></h1>
    <a class="link-arrow" href="/admin/events">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="<%= item ? '/admin/events/' + item.id + '/edit' : '/admin/events/new' %>" method="post">
    <%
      // Parse existing title into home/away teams
      let teamHome = '';
      let teamAway = '';
      if (item && item.title) {
        const parts = item.title.split(' : ');
        teamHome = parts[0] || '';
        teamAway = parts.length > 1 ? parts.slice(1).join(' : ') : '';
      }
    %>
    <div class="form-row">
      <label>
        <span>Heimmannschaft *</span>
        <input name="team_home" required value="<%= teamHome %>" placeholder="z.B. FC Zell" />
      </label>
      <label>
        <span>Gastmannschaft *</span>
        <input name="team_away" required value="<%= teamAway %>" placeholder="z.B. FC Beispiel" />
      </label>
    </div>

    <div class="form-row">
      <label>
        <span>Datum *</span>
        <%
          let d = new Date();
          if (item && item.event_date) d = new Date(item.event_date);
          const dateStr = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        %>
        <input type="date" name="event_date" required value="<%= item ? dateStr : '' %>" />
      </label>
      <label>
        <span>Zeit</span>
        <input type="time" name="event_time" value="<%= item ? item.event_time : '' %>" />
      </label>
    </div>

    <label>
      <span>Ort</span>
      <input name="location" value="<%= item ? item.location : '' %>" placeholder="z.B. Clubhaus Gass, Zell" />
    </label>

    <label>
      <span>Beschreibung</span>
      <textarea name="description" rows="6"><%= item ? item.description : '' %></textarea>
    </label>

    <div style="background: var(--fcz-cream); padding: 1.5rem; border-radius: var(--radius); margin-bottom: 2rem;">
      <h3 style="margin-bottom: 1rem; font-size: 1.2rem;">Live-Stream Link</h3>
      <label style="flex-direction: row; align-items: center; gap: 0.5rem; margin-bottom: 0;">
        <input type="checkbox" name="is_match" value="1" <%= item && item.is_match ? 'checked' : '' %> style="width: auto;" />
        <span style="font-weight: 600;">Live-Stream Badge mit Link zu Veo anzeigen</span>
      </label>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-lg" type="submit"><%= item ? 'Speichern' : 'Anlegen' %></button>
      <a class="btn btn-ghost" href="/admin/events">Abbrechen</a>
    </div>
  </form>
</div>

<%- include('_admin-footer') %>
