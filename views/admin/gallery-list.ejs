<% const pageTitle = 'Fotogalerie'; const active = 'gallery'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1>Fotogalerie</h1>
    <a class="btn btn-primary" href="/admin/gallery/new">+ Neues Foto</a>
  </div>

  <% const galleryNames = Object.keys(galleries); %>
  <% if (galleryNames.length === 0) { %>
    <p class="empty">Noch keine Fotos erfasst.</p>
  <% } else { %>
    <form action="/admin/gallery/bulk-delete" method="POST" id="bulkDeleteForm" onsubmit="return confirm('Ausgewählte Fotos wirklich löschen?');">
      <div style="margin-bottom: 2rem; padding: 1rem; background: var(--fcz-gray-100); border-radius: var(--radius); display: flex; gap: 1rem; align-items: center;">
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="document.querySelectorAll('.photo-cb').forEach(cb => cb.checked = true)">Alle markieren</button>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="document.querySelectorAll('.photo-cb').forEach(cb => cb.checked = false)">Auswahl aufheben</button>
        <button type="submit" class="btn btn-sm btn-danger">Ausgewählte löschen</button>
      </div>

      <% galleryNames.forEach(name => { %>
        <div style="margin-bottom: 2.5rem;">
          <h3 style="margin-bottom: 1rem; border-bottom: 1px solid var(--fcz-gray-200); padding-bottom: 0.5rem;"><%= name %></h3>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
            <% galleries[name].forEach(photo => { %>
              <div class="gallery-item" style="position: relative; width: 120px; cursor: pointer;" onclick="const cb = this.querySelector('.photo-cb'); if(event.target !== cb) cb.checked = !cb.checked;">
                <input type="checkbox" name="photoIds" value="<%= photo.id %>" class="photo-cb" style="position: absolute; top: 8px; left: 8px; transform: scale(1.5); cursor: pointer; z-index: 10;" />
                <img src="<%= photo.image_path %>" alt="<%= photo.caption || '' %>"
                     style="width: 120px; height: 120px; object-fit: cover; border-radius: 6px; border: 1px solid var(--fcz-gray-300); transition: opacity 0.2s;" 
                     onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'" />
                <% if (photo.caption) { %>
                  <div class="muted" style="font-size: 0.75rem; margin-top: 0.4rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center;" title="<%= photo.caption %>"><%= photo.caption %></div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </form>
  <% } %>
</div>

<%- include('_admin-footer') %>
