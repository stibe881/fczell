<% const pageTitle = gallery ? 'Galerie bearbeiten' : 'Neue Galerie'; const active = 'gallery'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= gallery ? 'Galerie bearbeiten' : 'Neue Galerie' %></h1>
    <a class="link-arrow" href="/admin/gallery">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="/admin/gallery/<%= gallery ? gallery.id + '/edit' : 'new-gallery' %>" method="post">
    <div class="form-group">
      <label for="name">Name der Galerie *</label>
      <input type="text" id="name" name="name" required value="<%= gallery ? gallery.name : '' %>" />
    </div>

    <div class="form-group">
      <label for="anlass_id">Zugeordneter Anlass</label>
      <select id="anlass_id" name="anlass_id">
        <option value="">-- Keiner / Allgemein --</option>
        <% anlaesse.forEach(a => { %>
          <option value="<%= a.id %>" <%= gallery && gallery.anlass_id === a.id ? 'selected' : '' %>><%= a.title %></option>
        <% }) %>
      </select>
      <small class="muted" style="display: block; margin-top: 0.25rem;">Wähle den Anlass, bei dem diese Fotos angezeigt werden sollen.</small>
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung, kleine Zahl zuerst)</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= gallery ? gallery.sort_order : 0 %>" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg"><%= gallery ? 'Speichern' : 'Erstellen' %></button>
      <a class="btn btn-ghost" href="/admin/gallery">Abbrechen</a>
    </div>
  </form>
</div>

<%- include('_admin-footer') %>
