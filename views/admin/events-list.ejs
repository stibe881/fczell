<% const pageTitle = 'Matchs verwalten'; const active = 'events'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1>Matchs</h1>
    <a class="btn btn-primary" href="/admin/events/new">+ Neues Match</a>
  </div>

  <% if (items.length === 0) { %>
    <p class="empty">Noch keine Matchs erfasst.</p>
  <% } else { %>
    <div class="admin-table-wrap">
    <table class="admin-table" id="adminEventsTable" style="table-layout: fixed;">
      <colgroup>
        <col style="width: 120px;">
        <col style="width: 70px;">
        <col style="width: auto;">
        <col style="width: 180px;">
        <col style="width: 200px;">
      </colgroup>
      <thead>
        <tr>
          <th class="sortable" data-sort="date" style="cursor: pointer; user-select: none;">Datum <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="sortable" data-sort="time" style="cursor: pointer; user-select: none;">Zeit <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="sortable" data-sort="title" style="cursor: pointer; user-select: none;">Titel <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="sortable" data-sort="location" style="cursor: pointer; user-select: none;">Ort <span class="sort-icon" style="opacity: 0.3; font-size: 0.8em; margin-left: 4px;">↕</span></th>
          <th class="actions">Aktionen</th>
        </tr>
      </thead>
      <tbody id="adminEventsTbody">
        <% items.forEach(ev => { %>
          <tr class="admin-event-row" 
              data-date="<%= new Date(ev.event_date).getTime() %>" 
              data-time="<%= ev.event_time || '' %>" 
              data-title="<%= ev.title.toLowerCase() %>" 
              data-location="<%= (ev.location || '').toLowerCase() %>">
            <td><%= formatDate(ev.event_date) %></td>
            <td><%= ev.event_time || '–' %></td>
            <td><strong><%= ev.title %></strong></td>
            <td><%= ev.location || '–' %></td>
            <td class="actions">
              <a class="btn btn-sm btn-primary" href="/admin/events/<%= ev.id %>/edit">bearbeiten</a>
              <form action="/admin/events/<%= ev.id %>/delete" method="post" onsubmit="return confirm('Match wirklich löschen?');" style="display:inline">
                <button class="btn btn-sm btn-danger" type="submit">löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<script>
  // Table Sorting Logic
  const tableBody = document.getElementById('adminEventsTbody');
  const headers = document.querySelectorAll('.sortable');
  let currentSort = { column: null, asc: true };

  if (headers.length > 0) {
    headers.forEach(header => {
      header.addEventListener('click', () => {
        const column = header.getAttribute('data-sort');
        const asc = currentSort.column === column ? !currentSort.asc : true;
        currentSort = { column, asc };

        // Update UI Icons
        headers.forEach(h => {
          const icon = h.querySelector('.sort-icon');
          if (icon) {
            icon.innerHTML = '↕';
            icon.style.opacity = '0.3';
            icon.style.color = 'inherit';
          }
        });
        const currentIcon = header.querySelector('.sort-icon');
        if (currentIcon) {
          currentIcon.innerHTML = asc ? '↓' : '↑';
          currentIcon.style.opacity = '1';
          currentIcon.style.color = 'var(--fcz-red)';
        }

        // Sort rows
        const rows = Array.from(tableBody.querySelectorAll('.admin-event-row'));
        rows.sort((a, b) => {
          let valA = a.getAttribute(`data-${column}`);
          let valB = b.getAttribute(`data-${column}`);

          // Numeric parsing for dates (milliseconds)
          if (column === 'date') {
            valA = parseInt(valA) || 0;
            valB = parseInt(valB) || 0;
          }

          if (valA < valB) return asc ? -1 : 1;
          if (valA > valB) return asc ? 1 : -1;
          return 0;
        });

        // Re-append rows
        rows.forEach(row => tableBody.appendChild(row));
      });
    });
  }
</script>

<%- include('_admin-footer') %>
