<% const pageTitle = 'Termine verwalten'; const active = 'events'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head">
    <h1>Termine &amp; Events</h1>
    <a class="btn btn-primary" href="/admin/events/new">+ Neuer Termin</a>
  </div>

  <% if (items.length === 0) { %>
    <p class="empty">Noch keine Termine erfasst.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Datum</th>
          <th>Zeit</th>
          <th>Titel</th>
          <th>Ort</th>
          <th class="actions">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(ev => { %>
          <tr>
            <td><%= formatDate(ev.event_date) %></td>
            <td><%= ev.event_time || '–' %></td>
            <td><strong><%= ev.title %></strong></td>
            <td><%= ev.location || '–' %></td>
            <td class="actions">
              <a class="btn btn-sm btn-primary" href="/admin/events/<%= ev.id %>/edit">bearbeiten</a>
              <form action="/admin/events/<%= ev.id %>/delete" method="post" onsubmit="return confirm('Termin wirklich löschen?');" style="display:inline">
                <button class="btn btn-sm btn-danger" type="submit">löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('_admin-footer') %>
