<% const pageTitle = 'Bandenwerber verwalten'; const active = 'advertisers'; %>
<%- include('_admin-header') %>

<div class="admin-content">
  <div class="admin-page-head" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1>Bandenwerber</h1>
    <div style="display: flex; gap: 1rem; align-items: center;">
      <div class="sort-toggle">
        <span class="muted" style="margin-right: 0.5rem; font-size: 0.9rem;">Sortierung:</span>
        <a href="?order=alpha" class="btn btn-sm <%= currentOrder === 'alpha' ? 'btn-primary' : 'btn-outline' %>">Alphabetisch</a>
        <a href="?order=newest" class="btn btn-sm <%= currentOrder === 'newest' ? 'btn-primary' : 'btn-outline' %>">Neuste</a>
      </div>
      <a class="btn btn-primary" href="/admin/advertisers/new">+ Neuer Bandenwerber</a>
    </div>
  </div>

  <% if (items.length === 0) { %>
    <p class="empty">Noch keine Bandenwerber erfasst.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Logo</th>
          <th>Name</th>
          <th>Ort</th>
          <th class="actions">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(s => { %>
          <tr>
            <td>
              <% if (s.logo) { %>
                <img src="<%= s.logo %>" alt="Logo" style="height: 30px; object-fit: contain;" />
              <% } else { %>
                <span class="muted">Kein Logo</span>
              <% } %>
            </td>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.location %></td>
            <td class="actions">
              <a class="btn btn-sm btn-primary" href="/admin/advertisers/<%= s.id %>/edit">bearbeiten</a>
              <form action="/admin/advertisers/<%= s.id %>/delete" method="post" onsubmit="return confirm('Wirklich löschen?');" style="display:inline">
                <button class="btn btn-sm btn-danger" type="submit">löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('_admin-footer') %>
