<%- include('_admin-header', { pageTitle: anlass ? 'Anlass bearbeiten' : 'Neuer Anlass', active: 'anlaesse' }) %>

<div class="admin-page-head" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <h1><%= anlass ? 'Anlass bearbeiten: ' + anlass.title : 'Neuer Anlass' %></h1>
  <a href="/admin/anlaesse" class="btn btn-ghost">Abbrechen</a>
</div>

<div class="admin-card">
  <form action="<%= anlass ? '/admin/anlaesse/' + anlass.id + '/edit' : '/admin/anlaesse/new' %>" method="POST" enctype="multipart/form-data" class="admin-form">
    
    <div class="form-row" style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label for="title">Titel</label>
        <input type="text" id="title" name="title" value="<%= anlass ? anlass.title : '' %>" required />
      </div>
      <div class="form-group">
        <label for="year">Jahr</label>
        <input type="number" id="year" name="year" value="<%= anlass && anlass.year ? anlass.year : new Date().getFullYear() %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="slug">URL-Slug (automatisch generiert aus Titel & Jahr)</label>
      <input type="text" id="slug" name="slug" value="<%= anlass ? anlass.slug : '' %>" required />
    </div>

    <div class="form-group">
      <label for="sort_order">Reihenfolge (Sortierung)</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= anlass ? anlass.sort_order : '0' %>" />
      <small>Kleinere Zahlen werden zuerst angezeigt.</small>
    </div>

    <div class="form-group">
      <label class="checkbox-label" style="font-weight: 600;">
        <input type="checkbox" id="is_archived" name="is_archived" value="1" <%= anlass && anlass.is_archived ? 'checked' : '' %> />
        Archivieren (Anlass ist vergangen und soll im Archiv angezeigt werden)
      </label>
    </div>

    <div class="form-group">
      <label for="form_type">Anlass-Typ / Template</label>
      <select id="form_type" name="form_type">
        <option value="standard" <%= anlass && anlass.form_type === 'standard' ? 'selected' : '' %>>Standard (Name, E-Mail, Telefon, Bemerkungen)</option>
        <option value="juniorenlager" <%= anlass && anlass.form_type === 'juniorenlager' ? 'selected' : '' %>>Juniorenlager Spezial-Formular</option>
        <option value="dorfturnier" <%= anlass && anlass.form_type === 'dorfturnier' ? 'selected' : '' %>>Dorfturnier Spezial-Formular</option>
        <option value="amtscup" <%= anlass && anlass.form_type === 'amtscup' ? 'selected' : '' %>>Amtscup (Spielplan & Reglement)</option>
      </select>
      <small>Bestimmt das Formular-Schema und welche Dokumente hochgeladen werden können.</small>
    </div>

    <div class="form-group">
      <label class="checkbox-label" style="font-weight: 600;">
        <input type="checkbox" id="has_form" name="has_form" value="1" <%= anlass && anlass.has_form ? 'checked' : '' %> onchange="document.getElementById('form-options').style.display = this.checked ? 'block' : 'none'" />
        Anmeldeformular aktivieren (öffentlich sichtbar)
      </label>
    </div>

    <div id="form-options" style="display: <%= anlass && anlass.has_form ? 'block' : 'none' %>; padding: 1.5rem; background: #f9fafb; border-radius: 8px; margin-bottom: 1.5rem;">
      <div class="form-group" style="margin-bottom: 0;">
        <label for="deadline">Anmeldeschluss (optional)</label>
        <input type="date" id="deadline" name="deadline" value="<%= anlass && anlass.deadline ? anlass.deadline : '' %>" />
        <small>Wenn ein Datum gesetzt ist, wird das Formular nach diesem Tag nicht mehr angezeigt.</small>
      </div>
    </div>

    <!-- Dokumente (Flyer / Spielplan / Reglement) -->
    <% const ft = anlass ? anlass.form_type : 'standard'; %>
    <% const showDocs = ft === 'standard' || ft === 'dorfturnier' || ft === 'amtscup'; %>
    <% const showSpielplan = ft === 'dorfturnier' || ft === 'amtscup'; %>
    <div id="docs-section" style="display: <%= showDocs ? 'block' : 'none' %>; padding: 1.5rem; background: #f0f7fb; border-radius: 8px; border: 1px solid rgba(26,128,182,0.15); margin-bottom: 1.5rem;">
      <h3 style="margin: 0 0 1rem; font-size: 1rem;">📎 Dokumente</h3>

      <!-- Flyer (standard, dorfturnier, amtscup) -->
      <div class="form-group" id="flyer-group">
        <label>Flyer (PDF/Bild)</label>
        <% if (anlass && anlass.flyer_file) { %>
          <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <a href="<%= anlass.flyer_file %>" target="_blank" class="btn btn-sm btn-primary" style="gap: 0.3rem;">📄 Aktueller Flyer</a>
            <label class="checkbox-label" style="font-size: 0.85rem; margin: 0;">
              <input type="checkbox" name="delete_flyer" value="1" /> Löschen
            </label>
          </div>
        <% } %>
        <input type="file" name="flyer_file" accept=".pdf,.png,.jpg,.jpeg" />
        <small>Flyer zum Anlass hochladen.</small>
      </div>

      <!-- Spielplan (dorfturnier, amtscup) -->
      <div class="form-group spielplan-group" style="display: <%= showSpielplan ? 'block' : 'none' %>;">
        <label>Spielplan (PDF)</label>
        <% if (anlass && anlass.spielplan_file) { %>
          <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <a href="<%= anlass.spielplan_file %>" target="_blank" class="btn btn-sm btn-primary" style="gap: 0.3rem;">📄 Aktueller Spielplan</a>
            <label class="checkbox-label" style="font-size: 0.85rem; margin: 0;">
              <input type="checkbox" name="delete_spielplan" value="1" /> Löschen
            </label>
          </div>
        <% } %>
        <input type="file" name="spielplan_file" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        <small>Spielplan hochladen (ersetzt vorhandenen).</small>
      </div>

      <!-- Reglement (dorfturnier, amtscup) -->
      <div class="form-group reglement-group" style="display: <%= showSpielplan ? 'block' : 'none' %>; margin-bottom: 0;">
        <label>Reglement (PDF)</label>
        <% if (anlass && anlass.reglement_file) { %>
          <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <a href="<%= anlass.reglement_file %>" target="_blank" class="btn btn-sm btn-primary" style="gap: 0.3rem;">📄 Aktuelles Reglement</a>
            <label class="checkbox-label" style="font-size: 0.85rem; margin: 0;">
              <input type="checkbox" name="delete_reglement" value="1" /> Löschen
            </label>
          </div>
        <% } %>
        <input type="file" name="reglement_file" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        <small>Reglement hochladen (ersetzt vorhandenes).</small>
      </div>
    </div>

    <div class="form-group">
      <label for="body">Inhalt (Informationen zum Anlass)</label>
      <small style="display:block; margin-bottom:0.5rem;">Du kannst Markdown verwenden (*kursiv*, **fett**, # Überschrift).</small>
      <textarea id="body" name="body" rows="15" style="font-family: monospace;"><%= anlass ? anlass.body : '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
  </form>
</div>

<!-- EasyMDE -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    new EasyMDE({
      element: document.getElementById('body'),
      spellChecker: false,
      hideIcons: ['image', 'side-by-side', 'fullscreen'],
      status: false,
      forceSync: true
    });
  });

  function updateSlug() {
    const title = document.getElementById('title').value;
    const year = document.getElementById('year').value;
    const combined = title + (year ? '-' + year : '');
    const slug = combined.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    document.getElementById('slug').value = slug;
  }

  <% if (!anlass) { %>
    document.getElementById('title').addEventListener('input', updateSlug);
    document.getElementById('year').addEventListener('input', updateSlug);
  <% } %>

  // Toggle Dokumente section based on form_type
  const formTypeSelect = document.getElementById('form_type');
  if (formTypeSelect) {
    function updateDocsVisibility() {
      const val = formTypeSelect.value;
      const showDocs = val === 'standard' || val === 'dorfturnier' || val === 'amtscup';
      const showSpielplan = val === 'dorfturnier' || val === 'amtscup';
      document.getElementById('docs-section').style.display = showDocs ? 'block' : 'none';
      document.querySelectorAll('.spielplan-group, .reglement-group').forEach(el => {
        el.style.display = showSpielplan ? 'block' : 'none';
      });
    }
    formTypeSelect.addEventListener('change', updateDocsVisibility);
  }
</script>

<%- include('_admin-footer') %>
