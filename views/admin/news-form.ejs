<% const pageTitle = item ? 'News bearbeiten' : 'News erfassen'; const active = 'news'; %>
<%- include('_admin-header') %>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= item ? 'Beitrag bearbeiten' : 'Neuer Beitrag' %></h1>
    <a class="link-arrow" href="/admin/news">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="<%= item ? '/admin/news/' + item.id + '/edit' : '/admin/news/new' %>" method="post" enctype="multipart/form-data">
    <label>
      <span>Titel *</span>
      <input name="title" required value="<%= item ? item.title : '' %>" />
    </label>

    <div class="form-row">
      <label>
        <span>Datum *</span>
        <%
          let d = new Date();
          if (item && item.published_at) d = new Date(item.published_at);
          const dateStr = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        %>
        <input type="date" name="published_at" required value="<%= dateStr %>" />
      </label>
      <label style="flex: 1;">
        <span>Kategorien (mehrere möglich)</span>
        <div style="margin-bottom: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
          <% 
            let selectedCats = item && item.category ? item.category.split(',').map(s => s.trim()) : ['Allgemein'];
            categories.forEach(c => { 
              if(!c.category) return;
              let isSelected = selectedCats.includes(c.category);
          %>
            <label style="display:flex; align-items:center; gap:0.25rem; font-weight:normal; cursor:pointer;">
              <input type="checkbox" name="category_chk" value="<%= c.category %>" <%= isSelected ? 'checked' : '' %> style="width:auto; margin:0;" />
              <%= c.category %>
            </label>
          <% }) %>
        </div>
        <input name="new_category" placeholder="Neue Kategorie(n) tippen (kommagetrennt)..." style="width:100%;" />
        <small class="muted">Kreuze bestehende an oder tippe neue Kategorien ein.</small>
      </label>
    </div>

    <label>
      <span>Kurzbeschreibung / Lead</span>
      <textarea name="excerpt" rows="2" placeholder="Kurzer Teaser für Übersichtsseiten"><%= item ? item.excerpt : '' %></textarea>
    </label>

    <div class="form-group" style="margin-top: 1rem;">
      <label>Beitragsbild (Featured Image)</label>
      <div class="admin-image-upload full-width">
        <% if (item && item.image) { %>
          <div class="admin-image-preview" id="image-preview-container">
            <img id="image-preview" src="<%= item.image %>" alt="Aktuelles Bild" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('image-preview').src=''; document.getElementById('image-preview-container').style.display='none';">✕ Entfernen</button>
          </div>
        <% } else { %>
          <div class="admin-image-preview" id="image-preview-container" style="display: none;">
            <img id="image-preview" src="" alt="Vorschau" />
            <button type="button" class="admin-image-delete-btn" onclick="document.getElementById('image-preview').src=''; document.getElementById('image-preview-container').style.display='none'; document.getElementById('image-input').value=''; document.getElementById('image-filename').textContent='Neues Bild auswählen...';">✕ Entfernen</button>
          </div>
        <% } %>
        <label class="admin-image-label" onclick="document.getElementById('image-input').click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span id="image-filename">Neues Bild auswählen...</span>
        </label>
        <input type="file" name="image" id="image-input" accept="image/*" class="admin-image-input" onchange="
          const file = this.files[0];
          const nameSpan = document.getElementById('image-filename');
          const previewCont = document.getElementById('image-preview-container');
          const previewImg = document.getElementById('image-preview');
          if(file) {
            nameSpan.textContent = file.name;
            previewCont.style.display = 'flex';
            previewImg.src = URL.createObjectURL(file);
          } else {
            nameSpan.textContent = 'Neues Bild auswählen...';
            previewCont.style.display = '<%- item && item.image ? 'flex' : 'none' %>';
            previewImg.src = '<%- item && item.image ? item.image : '' %>';
          }
        " />
        <small class="muted" style="margin-top: 0.25rem;">Erlaubt: JPG, PNG, WEBP, GIF. Ein neues Bild überschreibt das bestehende.</small>
      </div>
    </div>

    <div class="form-group">
      <label>Inhalt *</label>
      <input type="hidden" name="content" id="content_input" value="<%= item ? (item.content || '').replace(/"/g, '&quot;') : '' %>">
      <div id="editor" style="height: 300px; background: #fff;"><%- item ? (item.content || '') : '' %></div>
      <small class="muted">Der vollständige Beitrag. Mit dem Editor kannst du Texte formatieren, Bilder einfügen und verlinken.</small>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-lg" type="submit" onclick="document.getElementById('content_input').value = document.querySelector('.ql-editor').innerHTML;"><%= item ? 'Speichern' : 'Veröffentlichen' %></button>
      <a class="btn btn-ghost" href="/admin/news">Abbrechen</a>
    </div>
  </form>
</div>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
  var quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'header': 1 }, { 'header': 2 }],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'size': ['small', false, 'large', 'huge'] }],
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'font': [] }],
        [{ 'align': [] }],
        ['clean'],
        ['link', 'image']
      ]
    }
  });
</script>

<%- include('_admin-footer') %>
