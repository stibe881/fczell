<% const pageTitle = item ? 'News bearbeiten' : 'News erfassen'; const active = 'news'; %>
<%- include('_admin-header') %>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="admin-content">
  <div class="admin-page-head">
    <h1><%= item ? 'Beitrag bearbeiten' : 'Neuer Beitrag' %></h1>
    <a class="link-arrow" href="/admin/news">← zurück zur Übersicht</a>
  </div>

  <form class="admin-form" action="<%= item ? '/admin/news/' + item.id + '/edit' : '/admin/news/new' %>" method="post" enctype="multipart/form-data">
    <label>
      <span>Titel *</span>
      <input name="title" required value="<%= item ? item.title : '' %>" />
    </label>

    <div class="form-row">
      <label>
        <span>Datum *</span>
        <input type="date" name="published_at" required value="<%= item ? item.published_at : new Date().toISOString().slice(0,10) %>" />
      </label>
      <label>
        <span>Kategorie</span>
        <div style="display: flex; gap: 0.5rem;">
          <select onchange="document.getElementById('cat_input').value = this.value" style="flex: 1;">
            <option value="">-- Auswählen --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.category %>" <%= item && item.category === c.category ? 'selected' : (!item && c.category === 'Allgemein' ? 'selected' : '') %>><%= c.category %></option>
            <% }) %>
          </select>
          <input id="cat_input" name="category" value="<%= item ? item.category : 'Allgemein' %>" placeholder="Oder neue tippen..." style="flex: 1;" />
        </div>
      </label>
    </div>

    <label>
      <span>Kurzbeschreibung / Lead</span>
      <textarea name="excerpt" rows="2" placeholder="Kurzer Teaser für Übersichtsseiten"><%= item ? item.excerpt : '' %></textarea>
    </label>

    <label>
      <span>Beitragsbild (Featured Image)</span>
      <% if (item && item.image) { %>
        <div style="margin-bottom: 0.5rem;">
          <img src="<%= item.image %>" alt="Aktuelles Bild" style="max-height: 100px; border-radius: 4px;" />
        </div>
      <% } %>
      <input type="file" name="image" accept="image/*" />
      <small class="muted">Lade ein neues Bild hoch (optional). Dies überschreibt das bestehende Bild.</small>
    </label>

    <div class="form-group">
      <label>Inhalt *</label>
      <input type="hidden" name="content" id="content_input" value="<%= item ? (item.content || '').replace(/"/g, '&quot;') : '' %>">
      <div id="editor" style="height: 300px; background: #fff;"><%- item ? (item.content || '') : '' %></div>
      <small class="muted">Der vollständige Beitrag. Mit dem Editor kannst du Texte formatieren, Bilder einfügen und verlinken.</small>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary btn-lg" type="submit" onclick="document.getElementById('content_input').value = document.querySelector('.ql-editor').innerHTML;"><%= item ? 'Speichern' : 'Veröffentlichen' %></button>
      <a class="btn btn-ghost" href="/admin/news">Abbrechen</a>
    </div>
  </form>
</div>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
  var quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'header': 1 }, { 'header': 2 }],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'size': ['small', false, 'large', 'huge'] }],
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'font': [] }],
        [{ 'align': [] }],
        ['clean'],
        ['link', 'image']
      ]
    }
  });
</script>

<%- include('_admin-footer') %>
