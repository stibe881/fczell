<% const pageTitle = item.title; %>
<%- include('partials/header') %>

<article class="article-page">
  <div class="article-head">
    <a href="/news" class="back-link">← Zurück zu allen News</a>
    <span class="tag"><%= item.category %></span>
    <h1><%= item.title %></h1>
    <p class="article-meta">
      <time datetime="<%= item.published_at %>">
        <%= formatDate(item.published_at) %>
      </time>
    </p>
  </div>
  <% if (item.image) { %>
    <div style="margin: 2rem 0; position:relative; width:100%; border-radius:8px; overflow:hidden; display:flex; align-items:center; justify-content:center; background:var(--fcz-gray-800, #1f2937);">
      <div style="position:absolute; top:-20px; left:-20px; right:-20px; bottom:-20px; background-image:url('<%= item.image %>'); background-size:cover; background-position:center; filter:blur(20px); opacity:0.6; z-index:1;"></div>
      <img src="<%= item.image %>" alt="<%= item.title %>" style="position:relative; z-index:2; width: 100%; max-height: 600px; object-fit: contain; display:block;" />
    </div>
  <% } %>
  <div class="article-body">
    <% if (item.excerpt) { %><p class="lead"><%= item.excerpt %></p><% } %>
    <%- item.content || item.body %>
  </div>
</article>

<%- include('partials/footer') %>
