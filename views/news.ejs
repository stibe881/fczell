<% const pageTitle = 'News'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Aktuell</p>
    <h1>News &amp; Spielberichte</h1>
    <p>Alle Berichte, Updates und Mitteilungen aus dem FC Zell.</p>
  </div>
</section>

<section class="band band-light">
  <% if (news.length === 0) { %>
    <p class="empty">Aktuell sind keine News verfügbar.</p>
  <% } else { %>
    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
      <div class="news-filters">
        <button class="news-filter-btn active" data-filter="all">Alle</button>
        <% categories.forEach(c => { %>
          <button class="news-filter-btn" data-filter="<%= c.category %>"><%= c.category %></button>
        <% }) %>
      </div>
    <% } %>

    <div class="news-cards-grid">
      <% news.forEach(n => { %>
        <a href="/news/<%= n.id %>" class="news-card" data-category="<%= n.category || '' %>">
          <% if (n.image) { %>
          <div style="width:100%; aspect-ratio:16/9; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; background:var(--fcz-gray-800, #1f2937);">
            <div style="position:absolute; top:-20px; left:-20px; right:-20px; bottom:-20px; background-image:url('<%= n.image %>'); background-size:cover; background-position:center; filter:blur(15px); opacity:0.6; z-index:1;"></div>
            <img src="<%= n.image %>" alt="<%= n.title %>" style="position:relative; z-index:2; width:100%; height:100%; object-fit:contain; display:block;" />
          </div>
        <% } else { %>
          <div style="width:100%; aspect-ratio:16/9; background:var(--fcz-gray-200); display:block;"></div>
        <% } %>
        <div class="news-card-body">
            <div class="news-card-date"><%= formatDate(n.published_at) %><% if (n.category) { %> · <%= n.category %><% } %></div>
            <h3 class="news-card-title"><%= n.title %></h3>
            <% if (n.excerpt) { %><p class="news-card-excerpt"><%= n.excerpt %></p><% } %>
            <span class="news-card-link">Weiterlesen →</span>
          </div>
        </a>
      <% }) %>
    </div>

    <style>
    .news-cards-grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
    .news-card {
      background: #fff;
      border-radius: 6px;
      border: 1px solid rgba(0,0,0,0.08);
      overflow: hidden;
      transition: box-shadow 0.2s, transform 0.2s;
      text-decoration: none;
      color: inherit;
      display: block;
      display: flex;
  flex-direction: column;
}
    .news-card:hover {
      box-shadow: 0 6px 24px rgba(0,0,0,0.10);
      transform: translateY(-3px);
    }
    .news-card-body {
      padding: 1.5rem;
      display: flex;
  flex-direction: column;
  flex: 1;
}
    .news-card-date {
      font-size: 0.82rem;
      color: var(--fcz-gray-500);
      margin-bottom: 0.5rem;
    }
    .news-card-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--fcz-black);
      display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.88rem;
  line-height: 1.2;
}
    .news-card-excerpt {
      font-size: 0.95rem;
      color: var(--fcz-gray-700);
      line-height: 1.6;
      display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
    .news-card-link {
      display: inline-block;
      margin-top: auto;
      color: var(--fcz-red);
      font-weight: 600;
      font-size: 0.9rem;
    }
    .news-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
      justify-content: center;
    }
    .news-filter-btn {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.1);
      padding: 0.45rem 1.1rem;
      border-radius: 999px;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--fcz-gray-700);
      transition: all 0.2s;
    }
    .news-filter-btn:hover { background: #fafafa; border-color: rgba(0,0,0,0.2); color: var(--fcz-black); }
    .news-filter-btn.active {
      background: var(--fcz-red);
      color: #fff;
      border-color: var(--fcz-red);
    }
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.news-filter-btn');
      const cards = document.querySelectorAll('.news-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Update active state
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          // Filter cards
          const filter = btn.dataset.filter;
          cards.forEach(card => {
            const cardCats = card.dataset.category ? card.dataset.category.split(',').map(s => s.trim()) : [];
            if (filter === 'all' || cardCats.includes(filter)) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
    </script>
  <% } %>
</section>

<%- include('partials/footer') %>
