<% const pageTitle = 'Kontakt'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <h1>Schreib uns</h1>
  </div>
</section>

<section class="band band-light">
  <div class="contact-grid">
    <div class="contact-info">
      <div class="card">
        <h3>FC Zell</h3>
        <address>
          Postfach<br>
          6144 Zell LU<br><br>
          <a href="#" class="enc-email" data-user="info" data-domain="fczell.ch">info@fczell.ch</a>
        </address>
      </div>

      <div class="card" style="margin-top: 1.5rem;">
        <h3>Adressänderung</h3>
        <p>Bitte teile uns Adressänderungen über das Kontaktformular mit (Grund: «Adressänderung» auswählen).</p>
      </div>

      <% if (vorstand && vorstand.length > 0) { %>
        <div class="card" style="margin-top: 1.5rem;">
          <h3>Vorstand</h3>
          <ul class="contact-vorstand-list">
            <% vorstand.forEach(v => { %>
              <li>
                <strong><%= v.name %></strong><% if (v.role) { %> – <%= v.role %><% } %>
                <% if (v.phone) { %><br><a href="tel:<%= v.phone %>"><%= v.phone %></a><% } %>
                <% if (v.email) { %><br><a href="#" class="enc-email" data-user="<%= v.email.split('@')[0] %>" data-domain="<%= v.email.split('@')[1] %>"><%= v.email %></a><% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <div class="contact-form-wrap">
      <div class="card">
        <h3>Kontaktformular</h3>
        <form class="contact-form" method="post" action="/kontakt" id="contactForm">
          <input type="text" name="website_url" class="honeypot-field" style="position: absolute; left: -9999px;" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="fcz_token" id="fcz_token" value="">
          <div class="form-group">
            <label class="form-label" for="cf-grund">Grund der Anfrage *</label>
            <select class="form-control" id="cf-grund" name="subject" required>
              <option value="">Bitte wählen…</option>
              <option value="Allgemeiner Kontakt" <%= (typeof preselect !== 'undefined' && preselect === 'Allgemeiner Kontakt') ? 'selected' : '' %>>Allgemeiner Kontakt</option>
              <option value="Adressänderung" <%= (typeof preselect !== 'undefined' && preselect === 'Adressänderung') ? 'selected' : '' %>>Adressänderung</option>
              <option value="Clubhausbuchung" <%= (typeof preselect !== 'undefined' && preselect === 'Clubhausbuchung') ? 'selected' : '' %>>Clubhausbuchung</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-name">Name *</label>
            <input class="form-control" type="text" id="cf-name" name="name" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-email">E-Mail *</label>
            <input class="form-control" type="email" id="cf-email" name="email" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-phone">Telefon</label>
            <input class="form-control" type="tel" id="cf-phone" name="phone" />
          </div>

          <!-- Dynamic fields for Adressänderung -->
          <div id="fields-adresse" class="dynamic-fields" style="display: none;">
            <div class="form-group">
              <label class="form-label" for="cf-alte-adresse">Alte Adresse</label>
              <textarea class="form-control" id="cf-alte-adresse" name="alte_adresse" rows="2"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" for="cf-neue-adresse">Neue Adresse *</label>
              <textarea class="form-control" id="cf-neue-adresse" name="neue_adresse" rows="2"></textarea>
            </div>
          </div>

          <!-- Dynamic fields for Clubhausbuchung -->
          <div id="fields-clubhaus" class="dynamic-fields" style="display: none;">
            <div class="form-group">
              <label class="form-label" for="cf-datum">Gewünschtes Datum *</label>
              <input class="form-control" type="date" id="cf-datum" name="datum" />
            </div>
            <div class="form-group">
              <label class="form-label" for="cf-personen">Anzahl Personen</label>
              <input class="form-control" type="number" id="cf-personen" name="personen" min="1" />
            </div>
            <div class="form-group">
              <label class="form-label" for="cf-anlass">Anlass / Bemerkungen</label>
              <input class="form-control" type="text" id="cf-anlass" name="anlass" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-message">Nachricht *</label>
            <textarea class="form-control" id="cf-message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg">Nachricht senden</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const grundSelect = document.getElementById('cf-grund');
  const fieldsAdresse = document.getElementById('fields-adresse');
  const fieldsClubhaus = document.getElementById('fields-clubhaus');

  function updateFields() {
    const val = grundSelect.value;
    fieldsAdresse.style.display = val === 'Adressänderung' ? 'block' : 'none';
    fieldsClubhaus.style.display = val === 'Clubhausbuchung' ? 'block' : 'none';
    
    // Toggle required
    document.getElementById('cf-neue-adresse').required = (val === 'Adressänderung');
    document.getElementById('cf-datum').required = (val === 'Clubhausbuchung');
  }

  grundSelect.addEventListener('change', updateFields);
  updateFields();

  const contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', function() {
      document.getElementById('fcz_token').value = 'fcz_real_user_2026';
    });
  }
</script>

<%- include('partials/footer') %>
