<% const pageTitle = 'Impressum'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <h1><%= impressum ? impressum.title : 'Impressum' %></h1>
  </div>
</section>

<section class="band band-light">
  <div class="container">
    <div class="legal-container">
      <% if (impressum) { %>
        <%- mdToHtml(impressum.body) %>
      <% } else { %>
        <p>Das Impressum wird in Kürze veröffentlicht.</p>
      <% } %>
    </div>
  </div>
</section>

<style>
  .legal-container {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    padding: 3rem;
    border-radius: var(--radius);
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  }
  .legal-container h1, .legal-container h2, .legal-container h3 {
    color: var(--fcz-gray-800);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .legal-container h1 {
    font-size: 2rem;
    border-bottom: 2px solid var(--fcz-red);
    padding-bottom: 0.5rem;
    display: inline-block;
  }
  .legal-container h2 {
    font-size: 1.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 0.5rem;
  }
  .legal-container h3 {
    font-size: 1.25rem;
  }
  .legal-container p {
    line-height: 1.7;
    color: var(--fcz-gray-700);
    margin-bottom: 1.5rem;
  }
  .legal-container ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--fcz-gray-700);
  }
  .legal-container li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .legal-container a {
    color: var(--fcz-red);
    text-decoration: none;
    font-weight: 500;
  }
  .legal-container a:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .legal-container {
      padding: 1.5rem;
    }
  }
</style>

<%- include('partials/footer') %>
