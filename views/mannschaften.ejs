<section class="band band-cream" id="junioren">
  <div class="band-head" style="text-align: center; justify-content: center;">
    <div>
      <p class="eyebrow">Nachwuchs</p>
      <h2>Unsere Junioren</h2>
    </div>
  </div>
  <div class="teams-grid">
    <% juniorTeams.forEach(team => { %>
      <a href="/mannschaften/junioren/<%= team.slug %>" class="team-tile">
        <h3><%= team.name %></h3>
        <% if (team.league) { %><span class="tag"><%= team.league %></span><% } %>
        <span class="team-tile-link">Team Details →</span>
      </a>
    <% }) %>
  </div>
