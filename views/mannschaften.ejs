<!-- ============ PAGE STYLES ============ -->
<style>
/* ---------- SECTION NAV ---------- */
.section-nav {
  position: sticky;
  top: var(--header-h);
  z-index: 90;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: saturate(180%) blur(12px);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.section-nav-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--pad-x);
  display: flex;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.section-nav-inner::-webkit-scrollbar { display: none; }
.section-nav-link {
  display: inline-block;
  padding: 1rem 1.25rem;
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--fcz-gray-700);
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 3px solid transparent;
  transition: color var(--transition), border-color var(--transition);
}
.section-nav-link:hover {
  color: var(--fcz-red);
}
.section-nav-link.active {
  color: var(--fcz-red);
  border-bottom-color: var(--fcz-red);
}

/* ---------- MATCHCENTER IFRAME ---------- */
.matchcenter-iframe-wrap {
  width: 100%;
}

/* ---------- TEAM ROW (simple band layout) ---------- */
.team-row {
  /* simple block layout, no grid */
}
.team-head {
  margin-bottom: 2rem;
}

/* ---------- TEAMS GRID (Junioren tiles) ---------- */
.teams-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
}
.team-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 1.5rem;
  background: #fff;
  border-radius: var(--radius);
  border: 1px solid rgba(0, 0, 0, 0.06);
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s, box-shadow 0.2s;
  text-align: center;
  cursor: pointer;
}
.team-tile:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}
.team-tile h3 {
  margin: 0;
  font-size: 1.5rem;
}
.team-tile .tag {
  margin-top: 0.5rem;
}
.team-tile-link {
  display: inline-block;
  margin-top: 1rem;
  color: var(--fcz-red);
  font-weight: 600;
  font-size: 0.9rem;
}

/* ---------- LINK BUTTONS ---------- */
.teams-link-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
}
</style>


<!-- ============ SCRIPTS ============ -->
<script>
// Section nav active state on scroll
(function() {
  const navLinks = document.querySelectorAll('.section-nav-link');
  const sections = [];
  navLinks.forEach(link => {
    const id = link.getAttribute('href').replace('#', '');
    const el = document.getElementById(id);
    if (el) sections.push({ id, el, link });
  });

  function updateActive() {
    const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
    const navH = document.getElementById('sectionNav') ? document.getElementById('sectionNav').offsetHeight : 50;
    const offset = headerH + navH + 20;
    let current = sections[0];

    for (const s of sections) {
      if (s.el.getBoundingClientRect().top <= offset) {
        current = s;
      }
    }

    navLinks.forEach(l => l.classList.remove('active'));
    if (current) current.link.classList.add('active');
  }

  let ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() {
        updateActive();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  updateActive();

  // Smooth scroll with offset
  navLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const id = this.getAttribute('href').replace('#', '');
      const target = document.getElementById(id);
      if (!target) return;
      const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
      const navH = document.getElementById('sectionNav') ? document.getElementById('sectionNav').offsetHeight : 50;
      const top = target.getBoundingClientRect().top + window.pageYOffset - headerH - navH;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });
})();
</script>

<%- include('partials/footer') %>
