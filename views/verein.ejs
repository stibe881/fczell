<% const pageTitle = 'Unser Verein'; %>
<%- include('partials/header') %>

<!-- ============ HERO ============ -->
<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">FC Zell · seit 1960</p>
    <h1>Unser Verein</h1>
    <p>Vom Piccolo bis zur 3. Liga – der FC Zell ist Heimat des Fussballs in Zell. Entdecke unseren Verein, unsere Mannschaften und alles rund um den FCZ.</p>
  </div>
</section>

<!-- ============ SECTION NAV ============ -->
<nav class="section-nav" id="sectionNav">
  <div class="section-nav-inner">
    <a href="#portrait" class="section-nav-link active">Portrait</a>
    <a href="#vorstand" class="section-nav-link">Vorstand</a>
    <a href="#trainer" class="section-nav-link">Trainer</a>
    <a href="#verhaltenscodex" class="section-nav-link">Verhaltenscodex</a>
    <a href="#clubhaus" class="section-nav-link">Clubhaus</a>
    <a href="#penaltyclub" class="section-nav-link">Penaltyclub</a>
    <a href="#sponsoren" class="section-nav-link">Sponsoren</a>
  </div>
</nav>


<!-- ============ #portrait ============ -->
<section class="band band-light" id="portrait">
  <div class="band-head">
    <div>
      <p class="eyebrow">Kurzportrait</p>
      <h2><%= intro ? intro.title : 'Über uns' %></h2>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="verein-stats">
    <div class="verein-stat">
      <span class="verein-stat-value">3. Liga</span>
      <span class="verein-stat-label">Höchste Mannschaft</span>
    </div>
    <div class="verein-stat">
      <span class="verein-stat-value">1960</span>
      <span class="verein-stat-label">Gründungsjahr</span>
    </div>
    <div class="verein-stat">
      <span class="verein-stat-value">~300</span>
      <span class="verein-stat-label">Mitglieder</span>
    </div>
    <div class="verein-stat">
      <span class="verein-stat-value">9</span>
      <span class="verein-stat-label">Mannschaften</span>
    </div>
  </div>

  <div class="history-grid">
    <div class="history-content">
      <% if (intro && intro.body) { %>
        <div class="prose">
          <%- mdToHtml(intro.body) %>
        </div>
      <% } %>
    </div>
    <div class="history-card">
      <div class="history-card-inner">
        <span class="history-badge">Gründermannschaft FC Zell 1960</span>
        <div class="history-image-wrapper" onclick="openLightbox('/images/gruendung1960.png')">
          <img src="/images/gruendung1960.png" alt="Gründermannschaft 1960" loading="lazy" />
        </div>
        <div class="history-names">
          <div class="name-row">
            <span class="name-label">Obere Reihe:</span>
            <span class="name-list">Pfister Guido, Greber Toni, Ruckstuhl Peter, Grüter Edwin, Jurt Paul, Kunz Werner, Rupert Peter</span>
          </div>
          <div class="name-row">
            <span class="name-label">Untere Reihe:</span>
            <span class="name-list">Kammermann Walter, Graber Hans, Graber Alfred, Lütolf Toni, Bossardt Thomas, Trachsel Hans</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ============ #vorstand ============ -->
<section class="band band-cream" id="vorstand">
  <div class="band-head" style="justify-content: center; text-align: center;">
    <div>
      <p class="eyebrow">Führung</p>
      <h2>Unser Vorstand</h2>
      <p class="band-sub" style="margin: 1rem auto 0;">Engagierte Persönlichkeiten leiten den FC Zell ehrenamtlich mit viel Herzblut und Leidenschaft.</p>
    </div>
  </div>

  <div class="vorstand-grid">
    <% vorstand.forEach(p => { %>
      <div class="vorstand-card">
        <div class="vorstand-avatar">
          <% if (p.photo) { %>
            <img src="<%= p.photo %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
          <% } else { %>
            <% const initials = p.name.split(' ').map(n => n[0]).join('').substring(0, 2); %>
            <%= initials %>
          <% } %>
        </div>
        <div class="vorstand-info">
          <h3 class="vorstand-name"><%= p.name %></h3>
          <span class="vorstand-role"><%= p.role %></span>
        </div>
        <div class="vorstand-contact">
          <% if (p.address) { %>
            <div class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span><%= p.address %></span>
            </div>
          <% } %>
          <% if (p.phone) { %>
            <a href="tel:<%= p.phone.replace(/\s/g,'') %>" class="contact-item link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span><%= p.phone %></span>
            </a>
          <% } %>
          <% if (p.email) { %>
            <a href="mailto:<%= p.email %>" class="contact-item link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              <span><%= p.email %></span>
            </a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ============ #trainer ============ -->
<section class="band band-light" id="trainer">
  <div class="container" style="max-width: 1200px; margin: 0 auto;">
    <details class="trainer-details">
      <summary class="band-head" style="justify-content: center; text-align: center; cursor: pointer; list-style: none;">
        <div>
          <p class="eyebrow">Trainer & Staff</p>
          <h2 style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-bottom: 0;">
            Unsere Trainer
            <svg class="trainer-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </h2>
          <p class="band-sub" style="margin: 1rem auto 0;">Die sportlichen Leiter unserer Mannschaften. <span style="text-decoration: underline;">Klicken zum Aufklappen</span>.</p>
        </div>
      </summary>

      <% if (typeof trainers !== 'undefined' && trainers.length > 0) { %>
        <div class="trainer-filter" style="display:flex; justify-content:center; flex-wrap:wrap; gap:0.5rem; margin-top:2rem;">
          <button type="button" class="btn btn-primary filter-btn active" data-filter="all">Alle Teams</button>
          <% 
            // Extract unique team names, keeping order of appearance
            const uniqueTeams = [];
            trainers.forEach(t => { if(!uniqueTeams.includes(t.team_name)) uniqueTeams.push(t.team_name); });
            uniqueTeams.forEach(teamName => { 
          %>
            <button type="button" class="btn btn-outline-dark filter-btn" data-filter="<%= teamName %>"><%= teamName %></button>
          <% }) %>
        </div>
      <% } %>

      <div class="vorstand-grid" style="margin-top: 2rem;">
        <% if (typeof trainers !== 'undefined') { %>
          <% trainers.forEach(t => { %>
            <% const link = t.team_type === 'junioren' ? '/mannschaften/junioren/' + t.team_slug : '/mannschaften/aktive/' + t.team_slug; %>
            <a href="<%= link %>" class="vorstand-card" data-team="<%= t.team_name %>" style="text-decoration: none; color: inherit; display: block; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.06)'">
              <div class="vorstand-avatar">
                <% const initials = t.name.split(/[\s,]+/).map(n => n[0]).join('').substring(0, 2).toUpperCase(); %>
                <%= initials %>
                <% if (t.photo) { %>
                  <img src="<%= t.photo %>" alt="<%= t.name %>" loading="lazy" />
                <% } %>
              </div>
              <div class="vorstand-info">
                <h3 class="vorstand-name"><%= t.name %></h3>
                <span class="vorstand-role"><%= t.role %> · <%= t.team_name %></span>
              </div>
              <% if (t.phone || t.email) { %>
                <div class="vorstand-contact" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--fcz-gray-300);">
                  <% if (t.phone) { %>
                    <div class="contact-item link" style="display:flex; align-items:center; gap:0.5rem; font-size:0.9rem; color:var(--fcz-gray-600); margin-bottom:0.25rem;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                      <span><%= t.phone %></span>
                    </div>
                  <% } %>
                  <% if (t.email) { %>
                    <div class="contact-item link" style="display:flex; align-items:center; gap:0.5rem; font-size:0.9rem; color:var(--fcz-gray-600);">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                      <span><%= t.email %></span>
                    </div>
                  <% } %>
                </div>
              <% } %>
            </a>
          <% }) %>
        <% } %>
      </div>
    </details>
  </div>
</section>

<style>
.trainer-details summary::-webkit-details-marker {
  display: none;
}
.trainer-details[open] .trainer-icon {
  transform: rotate(180deg);
}
.trainer-icon {
  transition: transform 0.3s ease;
}
</style>
<script>
  document.querySelectorAll('.trainer-filter .filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Update active state
      document.querySelectorAll('.trainer-filter .filter-btn').forEach(b => {
        b.classList.remove('active', 'btn-primary');
        b.classList.add('btn-outline-dark');
      });
      btn.classList.remove('btn-outline-dark');
      btn.classList.add('active', 'btn-primary');
      
      const filter = btn.getAttribute('data-filter');
      
      // Filter cards
      document.querySelectorAll('#trainer .vorstand-card').forEach(card => {
        if (filter === 'all' || card.getAttribute('data-team') === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>


<!-- ============ #verhaltenscodex ============ -->
<% if (typeof verhaltenscodex !== 'undefined' && verhaltenscodex) { %>
<section class="band band-dark" id="verhaltenscodex">
  <div class="band-head">
    <div>
      <p class="eyebrow eyebrow-light">Werte</p>
      <h2><%= verhaltenscodex.title %></h2>
    </div>
  </div>
  <div class="prose prose-on-dark">
    <%- mdToHtml(verhaltenscodex.body) %>
  </div>
</section>
<% } %>


<!-- Mannschaften sind jetzt unter /mannschaften -->



<!-- ============ #clubhaus ============ -->
<section class="band band-dark" id="clubhaus">
  <div class="band-head" style="justify-content: center; text-align: center;">
    <div>
      <p class="eyebrow eyebrow-light">Infrastruktur</p>
      <h2>Clubhaus</h2>
      <p class="band-sub">Unser Clubhaus auf der Sportanlage Gass bietet die ideale Location für private Anlässe, Vereinsversammlungen oder Feste.</p>
    </div>
  </div>

  <% if (typeof clubhaus !== 'undefined' && clubhaus && clubhaus.body) { %>
    <div class="prose prose-on-dark" style="margin-bottom: 3rem;">
      <%- mdToHtml(clubhaus.body) %>
    </div>
  <% } %>

  <div class="clubhaus-grid">
    <div class="pricing-card">
      <div class="pricing-header">
        <h3>Tarife pro Tag</h3>
      </div>
      <ul class="pricing-list">
        <li><span>Vereinsmitglieder</span> <strong>CHF 200.–</strong></li>
        <li><span>Nichtmitglieder</span> <strong>CHF 350.–</strong></li>
        <li><span>Vereine &amp; Organisationen</span> <strong>CHF 350.–</strong></li>
