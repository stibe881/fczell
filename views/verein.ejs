<!-- ============ #penaltyclub ============ -->
<section class="band band-light" id="penaltyclub">
  <div class="band-head">
    <div>
      <p class="eyebrow">Gönner</p>
      <h2><%= penaltyclub ? penaltyclub.title : 'Penalty-Club' %></h2>
    </div>
  </div>
  <% if (penaltyclub) { %>
    <div class="prose">
      <%- mdToHtml(penaltyclub.body) %>
    </div>
  <% } %>
</section>


<!-- ============ #sponsoren ============ -->
<section class="band band-cream" id="sponsoren">
  <div class="band-head" style="justify-content: center; text-align: center;">
    <div>
      <p class="eyebrow">Partner</p>
      <h2>Unsere Sponsoren</h2>
      <% if (typeof sponsorenDank !== 'undefined' && sponsorenDank) { %>
        <div class="band-sub" style="margin: 1rem auto 0; max-width: 700px;">
          <%- mdToHtml(sponsorenDank.body) %>
        </div>
      <% } else { %>
        <p class="band-sub" style="margin: 1rem auto 0;">Ein grosses Dankeschön an alle, die den FC Zell unterstützen.</p>
      <% } %>
    </div>
  </div>

  <!-- Hauptsponsoren / Footer-Sponsoren -->
  <h3 style="text-align: center; margin-bottom: 2rem;">Unsere Premium Partner</h3>
  <div class="footer-sponsors" style="border-bottom: none; padding-top: 0; margin-bottom: 3rem;">
    <% sponsorenListe.forEach(sponsor => { %>
      <div class="footer-sponsor-item" style="box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <span class="footer-sponsor-cat"><%= sponsor.category %></span>
        <% if (sponsor.link) { %>
          <a href="<%= sponsor.link %>" target="_blank" rel="noopener">
            <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" class="footer-sponsor-logo" loading="lazy" />
          </a>
        <% } else { %>
          <img src="<%= sponsor.logo %>" alt="<%= sponsor.name %>" class="footer-sponsor-logo" loading="lazy" />
        <% } %>
      </div>
    <% }) %>
  </div>

  <!-- Sponsorentafel Photos -->
  <% if (typeof sponsorentafelPhotos !== 'undefined' && sponsorentafelPhotos && sponsorentafelPhotos.length > 0) { %>
    <div style="margin-top: 4rem; text-align: center;">
      <h3 style="margin-bottom: 2rem;">Sponsorentafel</h3>
      <div class="sponsorentafel-gallery">
        <% sponsorentafelPhotos.forEach(photo => { %>
          <div class="sponsorentafel-photo" onclick="openLightbox('<%= photo.image_path %>')">
            <img src="<%= photo.image_path %>" alt="<%= photo.alt_text || photo.caption || 'Sponsorentafel' %>" loading="lazy" />
            <% if (photo.caption) { %>
              <p style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--fcz-gray-500);"><%= photo.caption %></p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  
<div class="neubau-sponsors-section" style="margin-top: 6rem; margin-bottom: 6rem; padding: 4rem 2rem; background: var(--fcz-cream); border-radius: 32px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
  <div style="text-align: center; margin-bottom: 4rem;">
    <p class="eyebrow eyebrow-red" style="font-size: 1.1rem; letter-spacing: 2px;">Neubau Garderoben- und Clublokal</p>
    <h2 style="font-size: 2.8rem; text-transform: uppercase; margin-bottom: 1rem; color: var(--fcz-gray-900);">Herzlichen Dank!</h2>
    <p style="font-size: 1.2rem; color: var(--fcz-gray-600);">An unsere grosszügigen Sponsoren und Gönner</p>
  </div>
  
  <div style="text-align: center; max-width: 1000px; margin: 0 auto;">
    <div style="display: inline-block; padding: 12px; background: #fff; border: 3px solid var(--fcz-red); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); cursor: pointer;" onclick="document.getElementById('sponsorentafelOverlay').style.display='flex'">
      <img src="/images/sponsorentafel-neubau.jpg" alt="Sponsorentafel Neubau Clubhaus 2021" loading="lazy" style="width: 100%; display: block; border-radius: 8px;" />
    </div>
    <p style="margin-top: 0.75rem; font-size: 0.85rem; color: var(--fcz-gray-400);">Zum Vergrössern anklicken</p>
  </div>

  <!-- Lightbox with magnifier -->
  <div id="sponsorentafelOverlay" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.9); justify-content: center; align-items: center; padding: 1rem;">
    <button onclick="closeSponsorLightbox()" style="position: absolute; top: 1rem; right: 1.5rem; background: none; border: none; color: #fff; font-size: 2.5rem; cursor: pointer; z-index: 10002; line-height: 1;">&times;</button>
    <div id="sponsorZoomWrap" style="position: relative; max-width: 95%; max-height: 92vh; cursor: none;">
      <img id="sponsorImg" src="/images/sponsorentafel-neubau.jpg" alt="Sponsorentafel" style="max-width: 100%; max-height: 92vh; display: block; border-radius: 6px;" />
      <div id="sponsorLens" style="display: none; position: absolute; width: 180px; height: 180px; border-radius: 50%; border: 3px solid rgba(255,255,255,0.8); box-shadow: 0 0 0 1px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.4); background-repeat: no-repeat; pointer-events: none; z-index: 10001;"></div>
    </div>
    <p style="position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.5); font-size: 0.8rem;">Bewege den Cursor über das Bild zum Zoomen</p>
  </div>

  <script>
  (function() {
    var overlay = document.getElementById('sponsorentafelOverlay');
    var wrap = document.getElementById('sponsorZoomWrap');
    var img = document.getElementById('sponsorImg');
    var lens = document.getElementById('sponsorLens');
    var zoom = 3;
    var lensSize = 180;

    function showLens(px, py) {
      var rect = img.getBoundingClientRect();
      var x = px - rect.left;
      var y = py - rect.top;
      if (x < 0 || y < 0 || x > rect.width || y > rect.height) {
        lens.style.display = 'none';
        return;
      }
      lens.style.display = 'block';
      lens.style.left = (x - lensSize / 2) + 'px';
      lens.style.top = (y - lensSize / 2) + 'px';
      // Use natural image dimensions for crisp rendering
      var ratioX = img.naturalWidth / rect.width;
      var ratioY = img.naturalHeight / rect.height;
      var bgW = img.naturalWidth * zoom / ratioX;
      var bgH = img.naturalHeight * zoom / ratioY;
      var natX = x * ratioX;
      var natY = y * ratioY;
      var bgX = -(natX * zoom / ratioX - lensSize / 2);
      var bgY = -(natY * zoom / ratioY - lensSize / 2);
      lens.style.backgroundImage = 'url(' + img.src + ')';
      lens.style.backgroundSize = bgW + 'px ' + bgH + 'px';
      lens.style.backgroundPosition = bgX + 'px ' + bgY + 'px';
    }

    wrap.addEventListener('mousemove', function(e) { showLens(e.clientX, e.clientY); });
    wrap.addEventListener('mouseleave', function() { lens.style.display = 'none'; });
    wrap.addEventListener('touchmove', function(e) {
      e.preventDefault();
      var t = e.touches[0];
      showLens(t.clientX, t.clientY);
    }, { passive: false });
    wrap.addEventListener('touchend', function() { lens.style.display = 'none'; });

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeSponsorLightbox();
    });

    window.closeSponsorLightbox = function() {
      overlay.style.display = 'none';
      lens.style.display = 'none';
    };
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.style.display === 'flex') closeSponsorLightbox();
    });
  })();
  </script>
</div>
