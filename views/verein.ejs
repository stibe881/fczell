<% const pageTitle = 'Verein'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Der Verein</p>
    <h1><%= intro ? intro.title : 'Über uns' %></h1>
    <p><%= intro ? intro.body : '' %></p>
  </div>
</section>

  <div class="geschichte-section" style="margin-bottom: 5rem;">
    <div class="prose" style="max-width: 800px; margin: 0 auto; text-align: center; color: var(--fcz-gray-700); font-size: 1.1rem; line-height: 1.8;">
      <h2 style="color: var(--fcz-black); margin-bottom: 1.5rem; font-size: 2rem;">Unsere Geschichte</h2>
      <p>Der FC Zell ist ein Fussballclub im Luzerner Hinterland. Er wurde 1960 gegründet.</p>
      <p>Wir verfügen über gut 300 Vereinsmitglieder, davon etwa 140 JuniorInnen. Am Meisterschaftsbetrieb nehmen wir mit neun Mannschaften teil. Unser schönes Clubhaus lädt zum Fussballspiele schauen und verweilen ein und kann auch für private Anlässe gemietet werden. Alle zwei Jahre führen wir ein Juniorenlager durch.</p>
      
      <div style="margin-top: 3rem; background: #fff; padding: 2rem; border-radius: var(--radius); border: 1px solid rgba(0,0,0,0.06);">
        <h4 style="color: var(--fcz-black); margin-bottom: 1rem; text-transform: uppercase;">Gründermannschaft FC Zell 1960</h4>
        <img src="/images/gruendung1960.png" alt="Gründermannschaft 1960" style="width: 100%; max-width: 600px; height: auto; border-radius: var(--radius); margin-bottom: 1.5rem;" loading="lazy" />
        <p style="font-size: 0.95rem; line-height: 1.6; text-align: center; margin: 0;">
          <strong>Obere Reihe von links:</strong> Pfister Guido, Greber Toni, Ruckstuhl Peter, Grüter Edwin, Jurt Paul, Kunz Werner, Rupert Peter<br>
          <strong>Untere Reihe von links:</strong> Kammermann Walter, Graber Hans, Graber Alfred, Lütolf Toni, Bossardt Thomas, Trachsel Hans
        </p>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 3rem;">
    <span class="badge" style="margin-bottom: 1rem;">Führung</span>
    <h2 style="font-size: 2.5rem; color: var(--fcz-black); margin-bottom: 1rem;">Unser Vorstand</h2>
    <p style="font-size: 1.1rem; color: var(--fcz-text); max-width: 600px; margin: 0 auto; line-height: 1.6;">
      Acht engagierte Persönlichkeiten leiten den FC Zell ehrenamtlich.
    </p>
  </div>

  <ul class="people-list">
    <% vorstand.forEach(p => { %>
      <li class="person">
        <div class="person-name">
          <h3><%= p.name %></h3>
          <span class="role"><%= p.role %></span>
        </div>
        <div class="person-details">
          <% if (p.address) { %><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-map-pin"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= p.address %></span><% } %>
          <% if (p.phone) { %><a href="tel:<%= p.phone.replace(/\s/g,'') %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> <%= p.phone %></a><% } %>
          <% if (p.email) { %><a href="mailto:<%= p.email %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-mail"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> <%= p.email %></a><% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>


<section class="band band-light" id="penaltyclub">
  <div class="band-head">
    <div>
      <p class="eyebrow">Gönner</p>
      <h2><%= penaltyclub.title %></h2>
    </div>
  </div>
  <div class="prose">
    <%- mdToHtml(penaltyclub.body) %>
  </div>
</section>

<section class="band band-accent" id="jobs">
  <div class="cta-row">
    <div>
      <p class="eyebrow"><%= jobs.title %></p>
      <h2>Mitanpacken statt nur zuschauen</h2>
      <div class="prose">
        <%- mdToHtml(jobs.body) %>
      </div>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href="mailto:joerg.graber@bithawk.ch">E-Mail senden</a>
      <a class="btn btn-outline-dark btn-lg" href="tel:0793339759">079 333 97 59</a>
    </div>
  </div>
</section>

<section class="band band-light" id="sponsoren">
  <div class="band-head" style="justify-content: center; text-align: center;">
    <div>
      <p class="eyebrow">Partner</p>
      <h2>Unsere Sponsoren</h2>
      <p class="band-sub">Ein grosses Dankeschön an alle, die den FC Zell unterstützen.</p>
    </div>
  </div>
  <ul class="sponsor-list">
    <% sponsorenListe.forEach(s => { %>
      <li>
        <a href="<%= s.link %>" target="_blank" rel="noopener noreferrer">
          <img src="<%= s.logo %>" alt="<%= s.name %>" class="sponsor-logo" loading="lazy" />
          <h4><%= s.kategorie %></h4>
        </a>
      </li>
    <% }) %>
  </ul>

  <div class="bandenwerber-section" style="margin-top: 4rem;">
    <div class="band-head" style="margin-bottom: 2rem; justify-content: center; text-align: center;">
      <div>
        <h3 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Vielen Dank unseren Bandenwerbern</h3>
        <p class="band-sub" style="margin: 0 auto;">und allen weiteren Sponsoren für die grossartige Unterstützung!</p>
      </div>
    </div>
    
    <ul class="bandenwerber-list">
      <% bandenwerber.forEach(b => { %>
        <li>
          <% if (b.link) { %>
            <a href="<%= b.link %>" target="_blank" rel="noopener noreferrer" class="b-name"><%= b.name %></a>
          <% } else { %>
            <span class="b-name"><%= b.name %></span>
          <% } %>
          <span class="b-loc"><%= b.location %></span>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<%- include('partials/footer') %>
