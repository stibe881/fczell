<!-- ============ SCRIPTS ============ -->
<script>
// Lightbox
function openLightbox(src) {
  document.getElementById('lightboxImg').src = src;
  document.getElementById('imageLightbox').classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('imageLightbox').classList.remove('show');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeLightbox();
});

// Section nav active state on scroll
(function() {
  const navLinks = document.querySelectorAll('.section-nav-link');
  const sections = [];
  navLinks.forEach(link => {
    const id = link.getAttribute('href').replace('#', '');
    const el = document.getElementById(id);
    if (el) sections.push({ id, el, link });
  });

  function updateActive() {
    const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
    const navH = document.getElementById('sectionNav') ? document.getElementById('sectionNav').offsetHeight : 50;
    const offset = headerH + navH + 20;
    let current = sections[0];

    for (const s of sections) {
      if (s.el.getBoundingClientRect().top <= offset) {
        current = s;
      }
    }

    navLinks.forEach(l => l.classList.remove('active'));
    if (current) current.link.classList.add('active');
  }

  let ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() {
        updateActive();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  updateActive();

  // Smooth scroll with offset
  navLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const id = this.getAttribute('href').replace('#', '');
      const target = document.getElementById(id);
      if (!target) return;
      const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
      const navH = document.getElementById('sectionNav') ? document.getElementById('sectionNav').offsetHeight : 50;
      const top = target.getBoundingClientRect().top + window.pageYOffset - headerH - navH;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });
})();
</script>

