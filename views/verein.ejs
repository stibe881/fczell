<% const pageTitle = 'Verein'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Der Verein</p>
    <h1><%= intro ? intro.title : 'Über uns' %></h1>
    <p><%= intro ? intro.body : '' %></p>
  </div>
</section>

<section class="band band-light" id="vorstand">
  <div class="band-head">
    <div>
      <p class="eyebrow">Führung</p>
      <h2>Unser Vorstand</h2>
      <p class="band-sub">Acht engagierte Persönlichkeiten leiten den FC Zell ehrenamtlich.</p>
    </div>
  </div>

  <ul class="people-list">
    <% vorstand.forEach(p => { %>
      <li class="person">
        <div class="person-name">
          <h3><%= p.name %></h3>
          <span class="role"><%= p.role %></span>
        </div>
        <div class="person-details">
          <% if (p.address) { %><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-map-pin"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= p.address %></span><% } %>
          <% if (p.phone) { %><a href="tel:<%= p.phone.replace(/\s/g,'') %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> <%= p.phone %></a><% } %>
          <% if (p.email) { %><a href="mailto:<%= p.email %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-mail"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> <%= p.email %></a><% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>


<section class="band band-light" id="penaltyclub">
  <div class="band-head">
    <div>
      <p class="eyebrow">Gönner</p>
      <h2><%= penaltyclub.title %></h2>
    </div>
  </div>
  <div class="prose">
    <%- mdToHtml(penaltyclub.body) %>
  </div>
</section>

<section class="band band-accent" id="jobs">
  <div class="cta-row">
    <div>
      <p class="eyebrow"><%= jobs.title %></p>
      <h2>Mitanpacken statt nur zuschauen</h2>
      <div class="prose">
        <%- mdToHtml(jobs.body) %>
      </div>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href="mailto:joerg.graber@bithawk.ch">E-Mail senden</a>
      <a class="btn btn-outline-dark btn-lg" href="tel:0793339759">079 333 97 59</a>
    </div>
  </div>
</section>

<section class="band band-light" id="sponsoren">
  <div class="band-head">
    <div>
      <p class="eyebrow">Partner</p>
      <h2>Unsere Sponsoren</h2>
      <p class="band-sub">Ein grosses Dankeschön an alle, die den FC Zell unterstützen.</p>
    </div>
  </div>
  <ul class="sponsor-list">
    <% sponsorenListe.forEach(s => { %>
      <li>
        <a href="<%= s.link %>" target="_blank" rel="noopener noreferrer">
          <img src="<%= s.logo %>" alt="<%= s.name %>" class="sponsor-logo" loading="lazy" />
          <h4><%= s.kategorie %></h4>
        </a>
      </li>
    <% }) %>
  </ul>
</section>

<%- include('partials/footer') %>
