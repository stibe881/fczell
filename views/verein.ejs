<% const pageTitle = 'Verein'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Der Verein</p>
    <h1><%= intro ? intro.title : 'Über uns' %></h1>
    <p><%= intro ? intro.body : '' %></p>
  </div>
</section>

  <div class="history-section" style="margin-bottom: 6rem; margin-top: 2rem;">
    <div class="history-grid">
      <div class="history-content">
        <h2 class="history-title">Unsere Geschichte</h2>
        <div class="history-text">
          <p>Der FC Zell ist ein Fussballclub im Luzerner Hinterland. Er wurde <strong>1960 gegründet</strong>.</p>
          <p>Wir verfügen über gut <strong>300 Vereinsmitglieder</strong>, davon etwa 140 JuniorInnen. Am Meisterschaftsbetrieb nehmen wir mit neun Mannschaften teil. Unser schönes Clubhaus lädt zum Fussballspiele schauen und verweilen ein und kann auch für private Anlässe gemietet werden. Alle zwei Jahre führen wir ein Juniorenlager durch.</p>
        </div>
      </div>
      
      <div class="history-card">
        <div class="history-card-inner">
          <span class="history-badge">Gründermannschaft FC Zell 1960</span>
          <div class="history-image-wrapper" onclick="openLightbox('/images/gruendung1960.png')">
            <img src="/images/gruendung1960.png" alt="Gründermannschaft 1960" loading="lazy" />
          </div>
          <div class="history-names">
            <div class="name-row">
              <span class="name-label">Obere Reihe:</span>
              <span class="name-list">Pfister Guido, Greber Toni, Ruckstuhl Peter, Grüter Edwin, Jurt Paul, Kunz Werner, Rupert Peter</span>
            </div>
            <div class="name-row">
              <span class="name-label">Untere Reihe:</span>
              <span class="name-list">Kammermann Walter, Graber Hans, Graber Alfred, Lütolf Toni, Bossardt Thomas, Trachsel Hans</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="vorstand-section" id="vorstand">
    <div style="text-align: center; margin-bottom: 4rem;">
      <span class="badge" style="margin-bottom: 1rem;">Führung</span>
      <h2 style="font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--fcz-black); margin-bottom: 1rem; position: relative; display: inline-block;">
        Unser Vorstand
        <span style="position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 60px; height: 4px; background: var(--fcz-red); border-radius: 2px;"></span>
      </h2>
      <p style="font-size: 1.15rem; color: var(--fcz-gray-700); max-width: 600px; margin: 2rem auto 0; line-height: 1.6;">
        Acht engagierte Persönlichkeiten leiten den FC Zell ehrenamtlich mit viel Herzblut und Leidenschaft.
      </p>
    </div>

    <div class="vorstand-grid">
      <% vorstand.forEach(p => { %>
        <div class="vorstand-card">
          <div class="vorstand-avatar">
            <% const initials = p.name.split(' ').map(n => n[0]).join('').substring(0, 2); %>
            <%= initials %>
          </div>
          <div class="vorstand-info">
            <h3 class="vorstand-name"><%= p.name %></h3>
            <span class="vorstand-role"><%= p.role %></span>
          </div>
          <div class="vorstand-contact">
            <% if (p.address) { %>
              <div class="contact-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span><%= p.address %></span>
              </div>
            <% } %>
            <% if (p.phone) { %>
              <a href="tel:<%= p.phone.replace(/\s/g,'') %>" class="contact-item link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <span><%= p.phone %></span>
              </a>
            <% } %>
            <% if (p.email) { %>
              <a href="mailto:<%= p.email %>" class="contact-item link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                <span><%= p.email %></span>
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>


<section class="band band-light" id="penaltyclub">
  <div class="band-head">
    <div>
      <p class="eyebrow">Gönner</p>
      <h2><%= penaltyclub.title %></h2>
    </div>
  </div>
  <div class="prose">
    <%- mdToHtml(penaltyclub.body) %>
  </div>
</section>

<section class="band band-accent" id="jobs">
  <div class="cta-row">
    <div>
      <p class="eyebrow"><%= jobs.title %></p>
      <h2>Mitanpacken statt nur zuschauen</h2>
      <div class="prose">
        <%- mdToHtml(jobs.body) %>
      </div>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href="mailto:joerg.graber@bithawk.ch">E-Mail senden</a>
      <a class="btn btn-outline-dark btn-lg" href="tel:0793339759">079 333 97 59</a>
    </div>
  </div>
</section>

<section class="band band-light" id="sponsoren">
  <div class="band-head" style="justify-content: center; text-align: center;">
    <div>
      <p class="eyebrow">Partner</p>
      <h2>Unsere Sponsoren</h2>
      <p class="band-sub">Ein grosses Dankeschön an alle, die den FC Zell unterstützen.</p>
    </div>
  </div>
  <ul class="sponsor-list">
    <% sponsorenListe.forEach(s => { %>
      <li>
        <a href="<%= s.link %>" target="_blank" rel="noopener noreferrer">
          <img src="<%= s.logo %>" alt="<%= s.name %>" class="sponsor-logo" loading="lazy" />
          <h4><%= s.kategorie %></h4>
        </a>
      </li>
    <% }) %>
  </ul>

  <div class="bandenwerber-section" style="margin-top: 4rem;">
    <div class="band-head" style="margin-bottom: 2rem; justify-content: center; text-align: center;">
      <div>
        <h3 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Vielen Dank unseren Bandenwerbern</h3>
        <p class="band-sub" style="margin: 0 auto;">und allen weiteren Sponsoren für die grossartige Unterstützung!</p>
      </div>
    </div>
    
    <ul class="bandenwerber-list">
      <% bandenwerber.forEach(b => { %>
        <li>
          <% if (b.link) { %>
            <a href="<%= b.link %>" target="_blank" rel="noopener noreferrer" style="text-decoration:none; color:inherit; display:flex; flex-direction:column; align-items:center;">
              <% if (b.logo) { %>
                <img src="<%= b.logo %>" alt="<%= b.name %>" loading="lazy" />
              <% } %>
              <span class="b-name"><%= b.name %></span>
              <span class="b-loc"><%= b.location %></span>
            </a>
          <% } else { %>
            <% if (b.logo) { %>
              <img src="<%= b.logo %>" alt="<%= b.name %>" loading="lazy" />
            <% } %>
            <span class="b-name"><%= b.name %></span>
            <span class="b-loc"><%= b.location %></span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<div id="imageLightbox" class="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
  <img class="lightbox-content" id="lightboxImg">
</div>
<script>
function openLightbox(src) {
  document.getElementById('lightboxImg').src = src;
  document.getElementById('imageLightbox').classList.add('show');
}
function closeLightbox() {
  document.getElementById('imageLightbox').classList.remove('show');
}
</script>

<%- include('partials/footer') %>
