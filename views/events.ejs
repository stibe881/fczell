<% const pageTitle = 'Events'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">Agenda</p>
    <h1>Events &amp; Termine</h1>
    <p>Generalversammlung, Dorfturnier, ProCam-Amtscup und mehr – alle Anlässe rund um den FC Zell.</p>
  </div>
</section>

<section class="band band-light">
  <div class="band-head">
    <div>
      <h2>Kommende Termine</h2>
    </div>
  </div>

  <% if (events.length === 0) { %>
    <p class="empty">Aktuell sind keine Termine geplant.</p>
  <% } else { %>
    <ul class="event-list">
      <% events.forEach(ev => {
           const d = new Date(ev.event_date);
      %>
        <li class="event-row" style="cursor: pointer;" onclick="window.location.href='/events/<%= ev.id %>'">
          <div class="event-date">
            <span class="event-day"><%= d.toLocaleDateString('de-CH', { weekday: 'long' }) %></span>
            <span class="event-num"><%= d.toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></span>
            <% if (ev.event_time) { %><span class="event-time"><%= ev.event_time %> Uhr</span><% } %>
          </div>
          <div class="event-body">
            <h3 style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <a href="/events/<%= ev.id %>" style="color: inherit; text-decoration: none;"><%= ev.title %></a>
              <% if (ev.is_match) { %>
                <a href="https://app.veo.co/clubs/fc-zell/teams/1-mannschaft-fc-zell/recordings/" target="_blank" onclick="event.stopPropagation();" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; color: #fff; background: var(--fcz-red); padding: 0.15rem 0.5rem; border-radius: 4px; display: inline-flex; align-items: center; gap: 0.3rem; text-decoration: none;">
                  <span style="display: inline-block; width: 6px; height: 6px; background: #fff; border-radius: 50%; animation: pulse-small 2s infinite;"></span>
                  Live
                </a>
              <% } %>
            </h3>
            <% if (ev.location) { %><p class="event-loc"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-map-pin"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= ev.location %></p><% } %>
            <% if (ev.description) { %><p><%= ev.description %></p><% } %>
          </div>
        </li>
      <% }) %>
    </ul>
    
    <style>
      @keyframes pulse-small {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
        100% { opacity: 1; transform: scale(1); }
      }
    </style>
    
    <div style="margin-top: 3rem; text-align: center;">
      <a href="/events/archiv" class="btn btn-outline-dark">Zum Archiv</a>
    </div>
  <% } %>
</section>

<section class="band band-dark">
  <div class="band-head">
    <div>
      <p class="eyebrow eyebrow-light">Tradition</p>
      <h2>Wiederkehrende Anlässe</h2>
    </div>
  </div>
  <div class="prose prose-on-dark tradition-list">
    <h3>Dorfturnier</h3>
    <p>Das traditionelle Dorfturnier findet jeden Sommer auf der Sportanlage Gass statt. In sechs Kategorien spielen Schüler, Vereine, Firmen, Frauen, Männer und Quartiere um den Sieg. Im Vordergrund stehen das gemütliche Beisammensein, der Penaltykiller und natürlich der Fussball – nicht zwingend in dieser Reihenfolge.</p>

    <h3>ProCam-Amtscup</h3>
    <p>Der traditionelle Vorbereitungs-Cup vor dem Saisonstart. 2023 wurde der FC Wauwil-Egolzwil Amtscupsieger – das Finale fand in Zell statt.</p>

    <h3>Matchballspende</h3>
    <p>Die Matchbälle der Heimspiele werden jeweils von Sponsoren und Gönnern gespendet. Eine schöne Tradition, die wir sehr schätzen.</p>

    <h3>Ewige Siegerliste</h3>
    <p>Alle Sieger und Highlights aus der Vereinsgeschichte – ein Stück Zeller Fussballhistorie.</p>
  </div>
</section>

<%- include('partials/footer') %>
