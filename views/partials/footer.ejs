<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.enc-email').forEach(el => {
      const revealEmail = function(e) {
        if (this.getAttribute('href') === '#') {
          if (e && e.type === 'click') e.preventDefault();
          const email = this.dataset.user + '@' + this.dataset.domain;
          this.href = 'mailto:' + email;
          this.innerHTML = email;
          if (e && e.type === 'click') window.location.href = this.href;
        }
      };
      el.addEventListener('mouseover', revealEmail);
      el.addEventListener('click', revealEmail);
    });
  });
</script>
