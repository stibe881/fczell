<% const pageTitle = 'Anlässe'; %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="page-hero-inner">
    <p class="eyebrow">FC Zell</p>
    <h1>Anlässe</h1>
    <p>Die Höhepunkte im Vereinsjahr – immer aktuell.</p>
  </div>
</section>

<!-- ========== SECTION NAV ========== -->
<nav class="section-nav" id="sectionNav">
  <div class="section-nav-inner">
    <% anlaesse.forEach((a, index) => { %>
      <a href="#<%= a.slug %>" class="section-nav-link <%= index === 0 ? 'active' : '' %>"><%= a.title %></a>
    <% }) %>
    <% if (archivedAnlaesse && archivedAnlaesse.length > 0) { %>
      <a href="#archiv" class="section-nav-link">Archiv</a>
    <% } %>
  </div>
</nav>

<% anlaesse.forEach((anlass, index) => { 
  const isDark = index % 2 === 1;
  const bandClass = isDark ? 'band-light' : 'band-cream'; 
%>
<section class="band <%= bandClass %>" id="<%= anlass.slug %>">
  <div class="band-head">
    <div>
      <p class="eyebrow">Event</p>
      <h2><%= anlass.title %></h2>
    </div>
  </div>

  <% if (anlass.body) { %>
    <div class="prose" style="margin-bottom: 3rem;">
      <%- mdToHtml(anlass.body) %>
    </div>
  <% } %>

  <% if (anlass.flyer_file || anlass.spielplan_file || anlass.reglement_file || anlass.traktanden_file || anlass.protokoll_file) { %>
    <div class="anlass-docs-wrapper">
      <button class="anlass-docs-toggle" onclick="toggleDocs(this)">
        <span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Dokumente & Downloads
        </span>
        <svg class="anlass-docs-chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="anlass-docs-content" style="display: none;">
        <div class="anlass-docs">
          <%
            const docs = [];
            if (anlass.flyer_file) docs.push({ label: 'Flyer', file: anlass.flyer_file });
            if (anlass.spielplan_file) docs.push({ label: 'Spielplan', file: anlass.spielplan_file });
            if (anlass.reglement_file) docs.push({ label: 'Reglement', file: anlass.reglement_file });
            if (anlass.traktanden_file) docs.push({ label: 'Traktanden', file: anlass.traktanden_file });
            if (anlass.protokoll_file) docs.push({ label: 'Protokoll', file: anlass.protokoll_file });
          %>
          <% docs.forEach(doc => { %>
            <% const ext = doc.file.split('.').pop().toLowerCase(); %>
            <% const isImage = ['jpg','jpeg','png','gif','webp'].includes(ext); %>
            <div class="anlass-doc-block">
              <div class="anlass-doc-block-header">
                <span class="anlass-doc-label"><%= doc.label %></span>
                <a href="<%= doc.file %>" target="_blank" rel="noopener" class="anlass-doc-open-btn">
                  Öffnen
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
              <% if (isImage) { %>
                <div class="anlass-doc-preview" onclick="openAnlassLightbox('<%= doc.file %>')" style="cursor:zoom-in;">
                  <img src="<%= doc.file %>" alt="<%= doc.label %> – <%= anlass.title %>" loading="lazy" />
                </div>
              <% } else { %>
                <div class="anlass-doc-preview anlass-doc-embed">
                  <iframe src="<%= doc.file %>#toolbar=0&navpanes=0" title="<%= doc.label %> – <%= anlass.title %>"></iframe>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Registration Form -->
  <% if (anlass.has_form) { 
       const isClosed = anlass.deadline && new Date() > new Date(anlass.deadline);
  %>
    <div class="anlass-card" id="<%= anlass.slug %>-anmeldung">
      <button class="anlass-card-header form-toggle-btn" onclick="toggleAnmeldung(this)" style="width: 100%; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border: none; text-align: left;">
        <h3>Anmeldung <%= anlass.title %></h3>
        <svg class="form-toggle-chevron" style="transition: transform 0.3s;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="anlass-card-body" style="display: none;">
        <% if (isClosed) { %>
          <div style="background: #ffebee; color: #c62828; padding: 1.5rem; border-radius: 8px; font-weight: 600; text-align: center;">
            Der Anmeldeschluss für diesen Anlass ist leider bereits erreicht.
          </div>
        <% } else { %>
          <form method="POST" action="/anlaesse/<%= anlass.slug %>/anmelden" class="anlass-form">
            
            <% if (anlass.form_type === 'juniorenlager') { %>
              <div class="form-row">
                <label><span>Name des Kindes *</span><input type="text" name="child_name" required /></label>
                <label><span>Geburtsdatum *</span><input type="date" name="child_birthdate" required /></label>
              </div>
              <div class="form-row">
                <label><span>Name Elternteil *</span><input type="text" name="parent_name" required /></label>
                <label><span>E-Mail *</span><input type="email" name="parent_email" required /></label>
              </div>
              <div class="form-row">
                <label><span>Telefon *</span><input type="tel" name="parent_phone" required /></label>
                <label><span>Adresse *</span><input type="text" name="address" required /></label>
              </div>
              <label><span>Allergien / Unverträglichkeiten</span><textarea name="allergies" rows="3" placeholder="Falls vorhanden, bitte hier angeben"></textarea></label>
            
            <% } else if (anlass.form_type === 'dorfturnier') { %>
              <label><span>Teamname *</span><input type="text" name="team_name" required /></label>
              <div class="form-row">
                <label><span>Kontaktperson *</span><input type="text" name="contact_name" required /></label>
                <label><span>E-Mail *</span><input type="email" name="contact_email" required /></label>
              </div>
              <div class="form-row">
                <label><span>Telefon *</span><input type="tel" name="contact_phone" required /></label>
                <label><span>Anzahl Spieler *</span><input type="number" name="player_count" min="1" max="30" required /></label>
              </div>
            
            <% } else { %>
              <label><span>Name / Kontaktperson *</span><input type="text" name="name" required /></label>
              <div class="form-row">
                <label><span>E-Mail *</span><input type="email" name="email" required /></label>
                <label><span>Telefon</span><input type="tel" name="phone" /></label>
              </div>
            <% } %>

            <label><span>Bemerkungen</span><textarea name="notes" rows="3" placeholder="Sonstige Hinweise"></textarea></label>
            <button type="submit" class="btn btn-primary btn-lg">Anmeldung absenden</button>
            <p class="form-note">Mit dem Absenden stimmst du der Verarbeitung deiner Angaben zur Bearbeitung der Anmeldung zu.</p>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Legacy specifics for existing galleries/docs -->
  <% if (anlass.slug === 'juniorenlager') { %>
    <% if (juniorenlagerNews && juniorenlagerNews.length > 0) { %>
      <div class="anlass-subsection">
        <h3>Tagesberichte</h3>
        <ul class="news-list">
          <% juniorenlagerNews.forEach(item => { %>
            <li class="news-row">
              <div class="news-row-date">
                <time>
                  <strong><%= new Date(item.published_at || item.created_at).getDate() %></strong>
                  <span><%= new Date(item.published_at || item.created_at).toLocaleDateString('de-CH', { month: 'short', year: 'numeric' }) %></span>
                </time>
              </div>
              <div class="news-row-body">
                <h3><a href="/news/<%= item.id %>"><%= item.title %></a></h3>
                <% if (item.lead) { %><p><%= item.lead %></p><% } %>
              </div>
              <a href="/news/<%= item.id %>" class="news-row-cta" aria-label="Weiterlesen">→</a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <% if (juniorenlagerDocs && juniorenlagerDocs.length > 0) { %>
      <div class="anlass-subsection">
        <h3>Dokumente</h3>
        <ul class="doc-list">
          <% juniorenlagerDocs.forEach(doc => { %>
            <li>
              <a href="<%= doc.file_path %>" target="_blank" rel="noopener" class="doc-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span><%= doc.title %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <% if (anlass.slug === 'amtscup') { %>
    <% if (amtscupDocs && amtscupDocs.length > 0) { %>
      <div class="anlass-subsection">
        <h3>Spielpläne & Reglement</h3>
        <ul class="doc-list">
          <% amtscupDocs.forEach(doc => { %>
            <li>
              <a href="<%= doc.file_path %>" target="_blank" rel="noopener" class="doc-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span><%= doc.title %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <% if (anlass.slug === 'dorfturnier') { %>
    <% if (dorfturnierDocs && dorfturnierDocs.length > 0) { %>
      <div class="anlass-subsection">
        <h3>Spielpläne</h3>
        <ul class="doc-list">
          <% dorfturnierDocs.forEach(doc => { %>
            <li>
              <a href="<%= doc.file_path %>" target="_blank" rel="noopener" class="doc-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span><%= doc.title %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <!-- Generic Assigned Galleries Rendering -->
  <% if (anlass.galleries && anlass.galleries.length > 0) { %>
    <% anlass.galleries.forEach(g => { %>
      <% if (g.photos && g.photos.length > 0) { %>
        <div class="anlass-subsection">
          <h3><%= g.name %></h3>
          <div class="gallery-grid">
            <% g.photos.forEach(photo => { %>
              <figure class="gallery-item" onclick="openAnlassLightbox('<%= photo.image_path %>')">
                <img src="<%= photo.image_path %>" alt="<%= photo.caption || '' %>" loading="lazy" />
              </figure>
            <% }) %>
          </div>
        </div>
      <% } %>
    <% }) %>
  <% } %>

  <% if (anlass.form_type === 'gv' || anlass.slug === 'generalversammlung' || anlass.slug === 'gv') { %>
    <% if (nextGv) { %>
      <div class="anlass-card" style="margin-bottom: 3rem;">
        <div class="anlass-card-header">
          <h3>Nächste GV</h3>
        </div>
        <div class="anlass-card-body">
          <div class="gv-event-details">
            <div class="gv-detail">
              <span class="gv-detail-label">Anlass</span>
              <span class="gv-detail-value"><%= nextGv.title %></span>
            </div>
            <% if (nextGv.event_date) { %>
              <div class="gv-detail">
                <span class="gv-detail-label">Datum</span>
                <span class="gv-detail-value"><%= new Date(nextGv.event_date).toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
              </div>
            <% } %>
            <% if (nextGv.event_time) { %>
              <div class="gv-detail">
                <span class="gv-detail-label">Zeit</span>
                <span class="gv-detail-value"><%= nextGv.event_time %> Uhr</span>
              </div>
            <% } %>
            <% if (nextGv.location) { %>
              <div class="gv-detail">
                <span class="gv-detail-label">Ort</span>
                <span class="gv-detail-value"><%= nextGv.location %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>



    <% if (gvDocs && gvDocs.length > 0) { %>
      <div class="anlass-subsection">
        <h3>Weitere Protokolle</h3>
        <ul class="doc-list">
          <% gvDocs.forEach(doc => { %>
            <li>
              <a href="<%= doc.file_path %>" target="_blank" rel="noopener" class="doc-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span><%= doc.title %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  <% } %>

</section>
<% }) %>

<% if (archivedAnlaesse && archivedAnlaesse.length > 0) { %>
<section class="band band-dark" id="archiv">
  <div class="band-head">
    <div>
      <p class="eyebrow">Archiv</p>
      <h2>Vergangene Anlässe</h2>
    </div>
  </div>
  <div class="prose" style="margin-bottom: 2rem; color: rgba(255,255,255,0.8);">
    <p>Hier finden Sie Impressionen vergangener Anlässe und Turniere.</p>
  </div>

  <div style="margin-bottom: 1.5rem; max-width: 400px;">
    <input type="text" id="archiveFilter" placeholder="Anlässe durchsuchen..." class="form-control" style="width: 100%; padding: 0.8rem 1rem; border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: #fff; outline: none; font-family: inherit;">
  </div>

  <% 
    // Extract unique titles for filter chips
    const uniqueTitles = [...new Set(archivedAnlaesse.map(a => a.title))].sort();
  %>
  <% if (uniqueTitles.length > 0) { %>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 3rem;" id="archiveChips">
      <button class="archive-chip active" data-filter="all" style="padding: 0.4rem 1rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid var(--fcz-red); background: var(--fcz-red); color: #fff; transition: all 0.2s;">Alle</button>
      <% uniqueTitles.forEach(t => { %>
        <button class="archive-chip" data-filter="<%= t.toLowerCase() %>" style="padding: 0.4rem 1rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.8); transition: all 0.2s;"><%= t %></button>
      <% }) %>
    </div>
  <% } %>

  <div id="archiveList">
    <% 
      // Group by year
      const archiveGroups = {};
      archivedAnlaesse.forEach(archAnlass => {
        const year = archAnlass.year || 'Weitere';
        if (!archiveGroups[year]) archiveGroups[year] = [];
        archiveGroups[year].push(archAnlass);
      });
      
      // Sort years descending (Weitere at the end)
      const sortedYears = Object.keys(archiveGroups).sort((a, b) => {
        if (a === 'Weitere') return 1;
        if (b === 'Weitere') return -1;
        return parseInt(b) - parseInt(a);
      });
    %>

    <% sortedYears.forEach(year => { %>
      <div class="archive-year-group" data-year="<%= year %>">
        <h3 style="color: var(--fcz-accent); font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.2); margin-bottom: 1.5rem; padding-bottom: 0.5rem;"><%= year %></h3>
        <% archiveGroups[year].forEach(archAnlass => { %>
          <div class="archive-item" style="margin-bottom: 1.5rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius); overflow: hidden;">
            <button class="archive-toggle" onclick="toggleArchive(this)" style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; background: transparent; border: none; color: #fff; cursor: pointer; font-size: 1.2rem; font-family: 'Inter', sans-serif; font-weight: 600; text-align: left;">
              <span class="archive-title"><%= archAnlass.title %></span>
              <svg class="archive-icon" style="transition: transform 0.3s;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            
            <div class="archive-content" style="display: none; padding: 0 1.5rem 1.5rem;">
              <% if (archAnlass.body) { %>
                <div class="anlass-docs-wrapper archive-docs-wrapper" style="margin-bottom: 2rem;">
                  <button class="anlass-docs-toggle" onclick="toggleDocs(this)">
                    <span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                      Informationen zum Anlass
                    </span>
                    <svg class="anlass-docs-chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <div class="anlass-docs-content" style="display: none;">
                    <div class="prose" style="color: rgba(255,255,255,0.8);">
                      <%- mdToHtml(archAnlass.body) %>
                    </div>
                  </div>
                </div>
              <% } %>

              <% if (archAnlass.flyer_file || archAnlass.spielplan_file || archAnlass.reglement_file || archAnlass.traktanden_file || archAnlass.protokoll_file) { %>
                <div class="anlass-docs-wrapper archive-docs-wrapper" style="margin-bottom: 2rem;">
                  <button class="anlass-docs-toggle" onclick="toggleDocs(this)">
                    <span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      Dokumente & Downloads
                    </span>
                    <svg class="anlass-docs-chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <div class="anlass-docs-content" style="display: none;">
                    <div class="anlass-docs">
                      <%
                        const archDocsList = [];
                        if (archAnlass.flyer_file) archDocsList.push({ label: 'Flyer', file: archAnlass.flyer_file });
                        if (archAnlass.spielplan_file) archDocsList.push({ label: 'Spielplan', file: archAnlass.spielplan_file });
                        if (archAnlass.reglement_file) archDocsList.push({ label: 'Reglement', file: archAnlass.reglement_file });
                        if (archAnlass.traktanden_file) archDocsList.push({ label: 'Traktanden', file: archAnlass.traktanden_file });
                        if (archAnlass.protokoll_file) archDocsList.push({ label: 'Protokoll', file: archAnlass.protokoll_file });
                      %>
                      <% archDocsList.forEach(doc => { %>
                        <% const ext = doc.file.split('.').pop().toLowerCase(); %>
                        <% const isImage = ['jpg','jpeg','png','gif','webp'].includes(ext); %>
                        <div class="anlass-doc-block">
                          <div class="anlass-doc-block-header">
                            <span class="anlass-doc-label"><%= doc.label %></span>
                            <a href="<%= doc.file %>" target="_blank" rel="noopener" class="anlass-doc-open-btn">
                              Öffnen
                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            </a>
                          </div>
                          <% if (isImage) { %>
                            <div class="anlass-doc-preview" onclick="openAnlassLightbox('<%= doc.file %>')" style="cursor:zoom-in;">
                              <img src="<%= doc.file %>" alt="<%= doc.label %> – <%= archAnlass.title %>" loading="lazy" />
                            </div>
                          <% } else { %>
                            <div class="anlass-doc-preview anlass-doc-embed">
                              <iframe src="<%= doc.file %>#toolbar=0&navpanes=0" title="<%= doc.label %> – <%= archAnlass.title %>"></iframe>
                            </div>
                          <% } %>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              <% } %>


              <!-- Galleries for this archived anlass -->
              <% if (archAnlass.galleries && archAnlass.galleries.length > 0) { %>
                <% archAnlass.galleries.forEach(g => { %>
                  <% if (g.photos && g.photos.length > 0) { %>
                    <div class="anlass-subsection">
                      <% if (archAnlass.galleries.length > 1) { %>
                        <h4 style="margin-bottom: 1rem; color: #fff;"><%= g.name %></h4>
                      <% } %>
                      <div class="gallery-grid">
                        <% g.photos.forEach(photo => { %>
                          <figure class="gallery-item" onclick="openAnlassLightbox('<%= photo.image_path %>')">
                            <img src="<%= photo.image_path %>" alt="" loading="lazy" />
                          </figure>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                <% }) %>
              <% } else { %>
                <p class="muted" style="color: rgba(255,255,255,0.5);">Noch keine Galerien vorhanden.</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
  <p id="noArchiveResults" style="display: none; color: rgba(255,255,255,0.5); padding: 2rem; text-align: center; border: 1px dashed rgba(255,255,255,0.2); border-radius: var(--radius);">Keine Anlässe gefunden.</p>
</section>

<script>
  function toggleArchive(btn) {
    const content = btn.nextElementSibling;
    const icon = btn.querySelector('.archive-icon');
    if (content.style.display === 'none') {
      content.style.display = 'block';
      icon.style.transform = 'rotate(180deg)';
      btn.style.borderBottom = '1px solid rgba(255,255,255,0.08)';
      btn.style.paddingBottom = '1rem';
      content.style.paddingTop = '1rem';
    } else {
      content.style.display = 'none';
      icon.style.transform = 'rotate(0deg)';
      btn.style.borderBottom = 'none';
      btn.style.paddingBottom = '1.5rem';
    }
  }

  function toggleAnmeldung(btn) {
    const content = btn.nextElementSibling;
    const chevron = btn.querySelector('.form-toggle-chevron');
    if (content.style.display === 'none') {
      content.style.display = 'block';
      chevron.style.transform = 'rotate(180deg)';
    } else {
      content.style.display = 'none';
      chevron.style.transform = 'rotate(0deg)';
    }
  }

  const searchInput = document.getElementById('archiveFilter');
  const chips = document.querySelectorAll('.archive-chip');
  let currentChipFilter = 'all';

  function applyFilters() {
    const term = searchInput ? searchInput.value.toLowerCase() : '';
    const groups = document.querySelectorAll('.archive-year-group');
    let hasAnyVisible = false;
    
    groups.forEach(group => {
      let hasVisibleInGroup = false;
      const items = group.querySelectorAll('.archive-item');
      
      items.forEach(item => {
        const title = item.querySelector('.archive-title').innerText.toLowerCase();
        
        const matchesText = title.includes(term);
        const matchesChip = currentChipFilter === 'all' || title.includes(currentChipFilter);
        
        if (matchesText && matchesChip) {
          item.style.display = 'block';
          hasVisibleInGroup = true;
          hasAnyVisible = true;
        } else {
          item.style.display = 'none';
        }
      });
      
      if (hasVisibleInGroup) {
        group.style.display = 'block';
      } else {
        group.style.display = 'none';
      }
    });

    const noResults = document.getElementById('noArchiveResults');
    if (noResults) {
      noResults.style.display = hasAnyVisible ? 'none' : 'block';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', applyFilters);
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      // Update active styling
      chips.forEach(c => {
        c.classList.remove('active');
        c.style.background = 'rgba(255,255,255,0.05)';
        c.style.border = '1px solid rgba(255,255,255,0.2)';
        c.style.color = 'rgba(255,255,255,0.8)';
      });
      chip.classList.add('active');
      chip.style.background = 'var(--fcz-red)';
      chip.style.border = '1px solid var(--fcz-red)';
      chip.style.color = '#fff';

      currentChipFilter = chip.getAttribute('data-filter');
      applyFilters();
    });
  });
</script>
<% } %>

<!-- ========== LIGHTBOX ========== -->
<div id="anlassLightbox" class="lightbox" onclick="closeAnlassLightbox()">
  <span class="lightbox-close" onclick="closeAnlassLightbox()">&times;</span>
  <img class="lightbox-content" id="anlassLightboxImg">
</div>

<!-- ========== DOC MODAL (fullscreen PDF viewer) ========== -->
<div id="docModal" class="doc-modal" onclick="closeDocModal()">
  <div class="doc-modal-inner" onclick="event.stopPropagation()">
    <button class="doc-modal-close" onclick="closeDocModal()">&times;</button>
    <iframe id="docModalIframe" src="" title="Dokument"></iframe>
