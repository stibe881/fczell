<!-- ========== SCRIPTS ========== -->
<script>
// ---------- Document Toggle ----------
function toggleDocs(btn) {
  const content = btn.nextElementSibling;
  const isOpen = content.style.display !== 'none';
  content.style.display = isOpen ? 'none' : 'block';
  btn.classList.toggle('open', !isOpen);
}

// ---------- Lightbox ----------
function openAnlassLightbox(src) {
  document.getElementById('anlassLightboxImg').src = src;
  document.getElementById('anlassLightbox').classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeAnlassLightbox() {
  document.getElementById('anlassLightbox').classList.remove('show');
  document.body.style.overflow = '';
}

// ---------- Doc Modal (fullscreen PDF) ----------
function openDocModal(src) {
  document.getElementById('docModalIframe').src = src;
  document.getElementById('docModal').classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeDocModal() {
  document.getElementById('docModal').classList.remove('show');
  document.getElementById('docModalIframe').src = '';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeAnlassLightbox();
    closeDocModal();
  }
});

// ---------- Section nav active state ----------
(function() {
  const nav = document.getElementById('sectionNav');
  const links = nav.querySelectorAll('.section-nav-link');
  const sections = [];

  links.forEach(function(link) {
    var id = link.getAttribute('href').replace('#', '');
    var section = document.getElementById(id);
    if (section) sections.push({ id: id, el: section, link: link });
  });

  function updateActive() {
    var scrollY = window.scrollY + nav.offsetHeight + 120;
    var current = sections[0];
    for (var i = 0; i < sections.length; i++) {
      if (sections[i].el.offsetTop <= scrollY) {
        current = sections[i];
      }
    }
    links.forEach(function(l) { l.classList.remove('active'); });
    if (current) current.link.classList.add('active');
  }

  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
})();
</script>

