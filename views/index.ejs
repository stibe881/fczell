<% const pageTitle = 'Home'; %>
<%- include('partials/header') %>

<% if (typeof veoLiveEmbed !== 'undefined' && veoLiveEmbed.trim().length > 0) { %>
<section class="hero stadion-modus" style="padding: 0; background: #000; position: relative;">
  <div class="stadion-header" style="position: absolute; top: 1.5rem; left: 1.5rem; z-index: 10; display: flex; align-items: center; gap: 0.75rem; background: rgba(0,0,0,0.5); padding: 0.5rem 1rem; border-radius: 20px; backdrop-filter: blur(5px);">
    <span class="live-pulse"></span>
    <span style="color: #fff; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; font-size: 0.9rem;">Live Übertragung</span>
  </div>
  <div class="video-container" style="position: relative; width: 100%; height: auto; aspect-ratio: 16/9; max-height: 85vh; max-width: calc(85vh * 16 / 9); margin: 0 auto; overflow: hidden; display: flex; justify-content: center; align-items: center; background: #000;">
    <iframe src="<%= veoLiveEmbed %>" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  </div>
</section>
<style>
  .stadion-modus iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  .live-pulse {
    width: 10px;
    height: 10px;
    background-color: #ff3b30;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 rgba(255, 59, 48, 0.7);
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); }
    70% { box-shadow: 0 0 0 8px rgba(255, 59, 48, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
  }
</style>
<% } else { %>
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="eyebrow">Fussballclub Zell · seit 1960</p>
    <h1><%= hero ? hero.title : 'Freundschaft. Leidenschaft. FC Zell.' %></h1>
    <p class="hero-lead">
      <%= hero ? hero.body : 'Wir verbinden sportliche Ambition mit konsequenter Juniorenförderung und einem aktiven und geselligen Vereinsleben.' %>
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/verein#mannschaften">Unsere Mannschaften</a>
      <a class="btn btn-outline btn-lg" href="/news">Aktuelle News</a>
    </div>
    <div class="hero-meta">
      <div><span>3. Liga</span>1. Mannschaft</div>
      <div><span>7</span>Junioren-Teams</div>
      <div><span>Gass</span>Sportanlage Zell</div>
    </div>
  </div>
</section>
<% } %>

<!-- 1. News -->
<section class="band band-light" id="news">
  <div class="band-head">
    <div>
      <p class="eyebrow">Aktuell</p>
      <h2>Neuigkeiten vom FC Zell</h2>
    </div>
    <a class="link-arrow" href="/news">Alle News &rarr;</a>
  </div>

  <div class="news-cards-grid">
    <% news.forEach(n => { %>
      <a href="/news/<%= n.id %>" class="news-card">
        <% if (n.image) { %>
          <img src="<%= n.image %>" alt="<%= n.title %>" style="width:100%; height:200px; object-fit:cover; display:block;" />
        <% } else { %>
          <div style="width:100%; height:200px; background:var(--fcz-gray-200); display:block;"></div>
        <% } %>
        <div class="news-card-body">
          <div class="news-card-date"><%= formatDate(n.published_at) %><% if (n.category) { %> · <%= n.category %><% } %></div>
          <h3 class="news-card-title"><%= n.title %></h3>
          <% if (n.excerpt) { %><p class="news-card-excerpt"><%= n.excerpt %></p><% } %>
          <span class="news-card-link">Weiterlesen →</span>
        </div>
      </a>
    <% }) %>
  </div>
</section>



<!-- CTA -->
<section class="band band-accent">
  <div class="cta-row">
    <div>
      <p class="eyebrow">Mitmachen</p>
      <h2>Werde Teil des FC Zell</h2>
      <p>Ob als Spieler, Trainer, Helfer oder Sponsor – beim FCZ ist Platz für alle, die den Fussball lieben.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href="/kontakt">Kontakt aufnehmen</a>
      <a class="btn btn-outline-dark btn-lg" href="/verein#sponsoren">Sponsor werden</a>
    </div>
  </div>
</section>

<style>
.news-cards-grid {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
}
.news-card {
  background: #fff;
  border-radius: 6px;
  border: 1px solid rgba(0,0,0,0.08);
  overflow: hidden;
  transition: box-shadow 0.2s, transform 0.2s;
  text-decoration: none;
  color: inherit;
  display: block;
  display: flex;
  flex-direction: column;
}
.news-card:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,0.10);
  transform: translateY(-3px);
}
.news-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.news-card-date {
  font-size: 0.82rem;
  color: var(--fcz-gray-500);
  margin-bottom: 0.5rem;
}
.news-card-title {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--fcz-black);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.88rem;
  line-height: 1.2;
}
.news-card-excerpt {
  font-size: 0.95rem;
  color: var(--fcz-gray-700);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.news-card-link {
  display: inline-block;
  margin-top: auto;
  color: var(--fcz-red);
  font-weight: 600;
  font-size: 0.9rem;
}
</style>

<%- include('partials/footer') %>
